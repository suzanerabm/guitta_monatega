---
import { useTranslations, getLocalizedPath } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);
---

<div class="about">
  <h1 class="about-title">{t.about.title}</h1>
  <div class="about-text">
    {t.about.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <div class="about-section">
    <p class="about-section-title">{t.about.universesLabel}</p>
    <div class="about-links">
      <a href={getLocalizedPath('/bichittos', locale as Locale)}>Bichittos</a>
      <a href={getLocalizedPath('/kammara', locale as Locale)}>Kammara</a>
      <a href={getLocalizedPath('/art', locale as Locale)}>{locale === 'en' ? 'Art' : 'Arte'}</a>
    </div>
  </div>

  <div class="about-section">
    <p class="about-section-title">{t.about.contactLabel}</p>
    <div class="about-links">
      <a href="#">placeholder@email.com</a>
    </div>
  </div>
</div>

<style>
  .about { max-width: 680px; margin: 0 auto; padding: 8rem 3rem 4rem; }
  .about-title {
    font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700;
    letter-spacing: 0.04em; margin-bottom: 2rem;
    opacity: 0; animation: fadeIn 1s ease 0.2s forwards;
  }
  .about-text {
    font-size: 1.05rem; line-height: 1.8; color: var(--ink-soft);
    font-weight: 300; opacity: 0; animation: fadeIn 1s ease 0.4s forwards;
  }
  .about-text p + p { margin-top: 1rem; }
  .about-section {
    margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #f0f0f0;
    opacity: 0; animation: fadeIn 1s ease 0.6s forwards;
  }
  .about-section-title {
    font-size: 0.75rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--ink-muted); margin-bottom: 1rem;
  }
  .about-links { display: flex; flex-direction: column; gap: 0.5rem; }
  .about-links a {
    font-size: 1rem; color: var(--ink); text-decoration: none;
    font-weight: 400; transition: color 0.2s;
  }
  .about-links a:hover { color: var(--ink-muted); }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 768px) { .about { padding: 7rem 1.5rem 3rem; } }
</style>
