---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import FilterBar from '../components/FilterBar/FilterBar.astro';
import ArtSection from '../components/ArtSection/ArtSection.astro';
import Modal from '../components/Modal/Modal.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { useTranslations } from '../i18n/translations';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const artBase = 'imgs/art';

interface ArtSectionData {
  id: string;
  title: string;
  technique: string;
  bg: string;
  titleColor: string;
  techColor: string;
  large: boolean;
  theme?: string;
}

const sectionIds = ['black', 'grafite', 'doodle', 'digital', 'collections', 'fimo', 'needle', 'clay', 'croche'] as const;

const sectionMeta: Record<string, { bg: string; titleColor: string; techColor: string; large: boolean; theme?: string }> = {
  black: { bg: '#1a1a1a', titleColor: '#fff', techColor: 'rgba(255,255,255,0.5)', large: false, theme: 'dark' },
  grafite: { bg: '#f0eeeb', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: true },
  doodle: { bg: '#f5f3ef', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: true },
  digital: { bg: '#eae8f0', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
  collections: { bg: '#f3f0e8', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
  fimo: { bg: '#eef2e8', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
  needle: { bg: '#e8eef2', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
  clay: { bg: '#f2ede8', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
  croche: { bg: '#f0e8f2', titleColor: '#333', techColor: 'rgba(51,51,51,0.5)', large: false },
};

const sections: ArtSectionData[] = sectionIds.map(id => {
  const meta = sectionMeta[id];
  const translated = t.art.sections[id];
  return {
    id,
    title: translated.title,
    technique: translated.technique,
    bg: meta.bg,
    titleColor: meta.titleColor,
    techColor: meta.techColor,
    large: meta.large,
    ...(meta.theme ? { theme: meta.theme } : {}),
  };
});

function getThumbs(sectionId: string): string[] {
  const dir = join(process.cwd(), 'public', artBase, sectionId, '_thumb');
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(jpg|jpeg|png|gif|webp)$/i.test(f))
      .sort()
      .map((f: string) => `/${artBase}/${sectionId}/_thumb/${f}`);
  } catch {
    return [];
  }
}

const sectionThumbs: Record<string, string[]> = {};
for (const s of sections) {
  sectionThumbs[s.id] = getThumbs(s.id);
}
---

<HeroSection
  label={t.art.heroLabel}
  title={t.art.heroTitle}
  background="linear-gradient(135deg, #f5f5f5, #e8e8e8, #f0f0f0)"
  textColor="#1a1d21"
  labelColor="#999"
  minHeight="35vh"
/>

<FilterBar filters={sections.map(s => ({id: s.id, label: s.title}))} />

{sections.map((s) => (
  <ArtSection
    id={s.id}
    title={s.title}
    technique={s.technique}
    bg={s.bg}
    titleColor={s.titleColor}
    techColor={s.techColor}
    large={s.large}
    thumbs={sectionThumbs[s.id]}
  />
))}

<Modal />

<ScrollReveal selector="[data-art]" threshold={0.05} once={false} />

<script define:vars={{ sections, sectionThumbs }}>
  // Register galleries
  document.addEventListener('DOMContentLoaded', () => {
    for (const s of sections) {
      const thumbs = sectionThumbs[s.id] || [];
      if (thumbs.length > 0) {
        window.registerGallery(s.id, thumbs);
      }
    }
  });
</script>

<script>
  // Open art gallery on thumb click
  function openArt(sectionId: string, idx: number) {
    const sectionData = (window as any).__artSections;
    if (!sectionData) return;
    const s = sectionData.find((sec: any) => sec.id === sectionId);
    if (!s) return;
    const theme = s.theme || undefined;
    (window as any).openGallery(sectionId, idx, s.title, s.technique, theme);
  }

  document.querySelectorAll('.art-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const el = thumb as HTMLElement;
      const section = el.dataset.section || '';
      const index = parseInt(el.dataset.index || '0', 10);
      openArt(section, index);
    });
  });
</script>

<script define:vars={{ sections }}>
  // Store section metadata for openArt
  window.__artSections = sections;
</script>
