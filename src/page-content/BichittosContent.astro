---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import CreatureSection from '../components/CreatureSection/CreatureSection.astro';
import CreatureCard from '../components/CreatureCard/CreatureCard.astro';
import CharacterStrip from '../components/CharacterStrip/CharacterStrip.astro';
import BookGallery from '../components/BookGallery/BookGallery.astro';
import Modal from '../components/Modal/Modal.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { useTranslations } from '../i18n/translations';
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const BOOKS_BASE = join(process.cwd(), 'public', 'imgs', 'books');
const BOOKS_URL = '/imgs/books';
const CHARS_BASE = join(process.cwd(), 'public', 'imgs', 'characters');
const CHARS_URL = '/imgs/characters';

function getCharacters(creature: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, creature);
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: f.replace(/\.[^.]+$/, '').replace(/-/g, ' '),
        image: `${CHARS_URL}/${creature}/${f}`,
      }));
  } catch {
    return [];
  }
}

const napcatChars = getCharacters('napcat');
const zecoChars = getCharacters('zeco');
const tayloChars = getCharacters('taylo');

interface BookDef {
  creature: string;
  id: string;
  label: string;
  soon?: boolean;
}

function buildBook(def: BookDef) {
  const coverPath = join(BOOKS_BASE, def.creature, def.id, 'cover.jpg');
  const hasCover = existsSync(coverPath);
  const isSoon = def.soon ?? !hasCover;
  return {
    id: `${def.creature}-${def.id}`,
    image: hasCover ? `${BOOKS_URL}/${def.creature}/${def.id}/cover.jpg` : undefined,
    alt: def.label,
    label: def.label,
    soon: isSoon,
  };
}

function getBookPages(creature: string, bookId: string): string[] {
  const pagesDir = join(BOOKS_BASE, creature, bookId, 'pages');
  try {
    return readdirSync(pagesDir)
      .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f))
      .sort()
      .map((f: string) => `${BOOKS_URL}/${creature}/${bookId}/pages/${f}`);
  } catch {
    return [];
  }
}

// NapCat books
const napcatBookDefs: BookDef[] = [
  { creature: 'napcat', id: 'adventures', label: t.bichittos.napcatBooks.adventures, soon: true },
];
const napcatBooks = napcatBookDefs.map(buildBook);

// Zeco books
const zecoBookDefs: BookDef[] = [
  { creature: 'zeco', id: 'primavera', label: t.bichittos.zecoBookSeasons.primavera },
  { creature: 'zeco', id: 'verao', label: t.bichittos.zecoBookSeasons.verao },
  { creature: 'zeco', id: 'outono', label: t.bichittos.zecoBookSeasons.outono },
  { creature: 'zeco', id: 'inverno', label: t.bichittos.zecoBookSeasons.inverno },
];
const zecoBooks = zecoBookDefs.map(buildBook);

// Taylo books
const tayloBookDefs: BookDef[] = [
  { creature: 'taylo', id: 'star-hunter', label: t.bichittos.tayloBooks.starHunter, soon: true },
];
const tayloBooks = tayloBookDefs.map(buildBook);

// Build gallery data for client-side (book pages for modal)
const bookIllustrated = t.bichittos.bookIllustrated;
const bookGalleries: Record<string, { title: string; pages: string[] }> = {};
for (const defs of [napcatBookDefs, zecoBookDefs, tayloBookDefs]) {
  for (const def of defs) {
    const pages = getBookPages(def.creature, def.id);
    if (pages.length > 0) {
      bookGalleries[`${def.creature}-${def.id}`] = {
        title: def.label,
        pages,
      };
    }
  }
}
---

<!-- HERO -->
<HeroSection
  label={t.bichittos.heroLabel}
  title={t.bichittos.heroTitle}
  description={t.bichittos.heroDesc}
  background="linear-gradient(135deg, #ff6b9d 0%, #ffa751 30%, #ffe259 60%, #6dd5fa 100%)"
>
  <div class="hero-shapes" slot="decorations">
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
  </div>
</HeroSection>

<!-- NAPCAT -->
<CreatureSection gradient="var(--gradient-napcat-bg)" accentColor="var(--color-napcat-1)">
  <CreatureCard name={t.bichittos.napcat.name} bannerImage="/imgs/banners/banner_napcat.jpg" color1="#b5a2dc" color2="#667eea" color3="#764ba2">
    <p>{t.bichittos.napcat.text}</p>
    <CharacterStrip slot="strip" gradient="var(--gradient-napcat)" side="left" characters={napcatChars} />
  </CreatureCard>
  <BookGallery title={t.bichittos.napcatBooksTitle} books={napcatBooks} soonLabel={t.common.soon} />
</CreatureSection>

<!-- ZECO -->
<CreatureSection gradient="var(--gradient-zeco-bg)" accentColor="var(--color-zeco-1)">
  <CreatureCard name={t.bichittos.zeco.name} bannerImage="/imgs/banners/banner_zeco.jpg" color1="#ffa751" color2="#ff8c42" color3="#ff6b35">
    <p>{t.bichittos.zeco.text}</p>
    <CharacterStrip slot="strip" gradient="var(--gradient-zeco)" side="left" characters={zecoChars} />
  </CreatureCard>
  <BookGallery title={t.bichittos.zecoBooksTitle} books={zecoBooks} />
</CreatureSection>

<!-- TAYLO -->
<CreatureSection gradient="var(--gradient-taylo-bg)" accentColor="var(--color-taylo-1)">
  <CreatureCard name={t.bichittos.taylo.name} bannerImage="/imgs/banners/banner_taylo.jpg" color1="#5d9466" color2="#427f49" color3="#277230">
    {t.bichittos.taylo.text.map((p) => <p>{p}</p>)}
    <CharacterStrip slot="strip" gradient="var(--gradient-taylo)" side="right" characters={tayloChars} />
  </CreatureCard>
  <BookGallery title={t.bichittos.tayloBooksTitle} books={tayloBooks} soonLabel={t.common.soon} />
</CreatureSection>

<Modal />
<ScrollReveal selector="[data-creature]" />

<style>
  .hero-shapes {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    background: #fff;
    animation: shapeFloat 6s ease-in-out infinite;
  }

  .hero-shape:nth-child(1) { width: 150px; height: 150px; top: 10%; left: 5%; }
  .hero-shape:nth-child(2) { width: 80px; height: 80px; top: 60%; right: 10%; animation-delay: 2s; border-radius: 30%; }
  .hero-shape:nth-child(3) { width: 100px; height: 100px; bottom: 15%; left: 20%; animation-delay: 1s; }

  .creature-divider {
    width: 40px;
    height: 1px;
    background: var(--color-border);
    margin: 4rem auto;
  }

  @keyframes shapeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }
</style>

<script is:inline define:vars={{ bookGalleries }}>
  // Register book galleries for modal
  document.addEventListener('DOMContentLoaded', () => {
    for (const [id, data] of Object.entries(bookGalleries)) {
      window.registerGallery('book_' + id, data.pages);
    }
  });
</script>

<script is:inline define:vars={{ bookGalleries, bookIllustrated }}>
  window.__bookGalleries = bookGalleries;
  window.__bookIllustrated = bookIllustrated;
</script>

<script>
  // Book click handlers
  document.querySelectorAll<HTMLElement>('[data-book]').forEach(el => {
    el.addEventListener('click', () => {
      const bookId = el.dataset.book!;
      const galleries = (window as any).__bookGalleries;
      const subtitle = (window as any).__bookIllustrated || 'Illustrated book';
      if (!galleries || !galleries[bookId]) return;
      (window as any).openGallery('book_' + bookId, 0, galleries[bookId].title, subtitle);
    });
  });
</script>
