---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import CreatureCard from '../components/CreatureCard/CreatureCard.astro';
import BookGallery from '../components/BookGallery/BookGallery.astro';
import Modal from '../components/Modal/Modal.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { useTranslations } from '../i18n/translations';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const napcatBooks = [
  { id: 'napcat-adventures', alt: t.bichittos.napcatBooks.adventures, label: t.bichittos.napcatBooks.adventures, soon: true },
];

const zecoBooks = [
  { id: 'primavera', image: '/imgs/banners/cover_primavera.jpg', alt: `Zeco - ${t.bichittos.zecoBookSeasons.primavera}`, label: t.bichittos.zecoBookSeasons.primavera },
  { id: 'verao', image: '/imgs/banners/cover_verao.jpg', alt: `Zeco - ${t.bichittos.zecoBookSeasons.verao}`, label: t.bichittos.zecoBookSeasons.verao },
  { id: 'outono', image: '/imgs/banners/cover_outono.jpg', alt: `Zeco - ${t.bichittos.zecoBookSeasons.outono}`, label: t.bichittos.zecoBookSeasons.outono },
  { id: 'inverno', image: '/imgs/banners/cover_inverno.jpg', alt: `Zeco - ${t.bichittos.zecoBookSeasons.inverno}`, label: t.bichittos.zecoBookSeasons.inverno },
];

const tayloBooks = [
  { id: 'star-hunter', alt: t.bichittos.tayloBooks.starHunter, label: t.bichittos.tayloBooks.starHunter, soon: true },
];
---

<!-- HERO -->
<HeroSection
  label={t.bichittos.heroLabel}
  title={t.bichittos.heroTitle}
  description={t.bichittos.heroDesc}
  background="linear-gradient(135deg, #ff6b9d 0%, #ffa751 30%, #ffe259 60%, #6dd5fa 100%)"
>
  <div class="hero-shapes" slot="decorations">
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
  </div>
</HeroSection>

<!-- NAPCAT -->
<CreatureCard name={t.bichittos.napcat.name} bannerImage="/imgs/banners/banner_napcat.jpg">
  <p>{t.bichittos.napcat.text}</p>
</CreatureCard>

<BookGallery title={t.bichittos.napcatBooksTitle} books={napcatBooks} />

<div class="creature-divider"></div>

<!-- ZECO -->
<CreatureCard name={t.bichittos.zeco.name} bannerImage="/imgs/banners/banner_zeco.jpg">
  <p>{t.bichittos.zeco.text}</p>
</CreatureCard>

<!-- ZECO BOOKS -->
<BookGallery title={t.bichittos.zecoBooksTitle} books={zecoBooks} />

<div class="creature-divider"></div>

<!-- TAYLO -->
<CreatureCard name={t.bichittos.taylo.name} bannerImage="/imgs/banners/banner_taylo.jpg">
  {t.bichittos.taylo.text.map((p) => <p>{p}</p>)}
</CreatureCard>

<BookGallery title={t.bichittos.tayloBooksTitle} books={tayloBooks} />

<Modal />
<ScrollReveal selector="[data-creature]" />

<style>
  .hero-shapes {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    background: #fff;
    animation: shapeFloat 6s ease-in-out infinite;
  }

  .hero-shape:nth-child(1) { width: 150px; height: 150px; top: 10%; left: 5%; }
  .hero-shape:nth-child(2) { width: 80px; height: 80px; top: 60%; right: 10%; animation-delay: 2s; border-radius: 30%; }
  .hero-shape:nth-child(3) { width: 100px; height: 100px; bottom: 15%; left: 20%; animation-delay: 1s; }

  .creature-divider {
    width: 40px;
    height: 1px;
    background: #e0e0e0;
    margin: 4rem auto;
  }

  @keyframes shapeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }
</style>

<script>
  // Book data
  const books: Record<string, { title: string; pages: string[] }> = {
    primavera: {
      title: 'Zeco na Primavera',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/primavera/_png/primaveracena_${i}_${['capa','intro','acordar','limpeza','flores','abelha','alvoroco','gralhaazul','colher','cozinhar','compota','piquenique','ipe','pordosol','capa_fim'][i]}.png`)
    },
    verao: {
      title: 'Zeco no Verao',
      pages: Array.from({ length: 16 }, (_, i) => `/imgs/Zeco/Books/verao/_png/veraocena_${i}_${['capa','intro','nadando','rio','secando','praia','refrescando','pescando','chovendo','picole','carnaval','soneca','brincar','chule','limpar','fim'][i]}.png`)
    },
    outono: {
      title: 'Zeco no Outono',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/outono/_png/outonocena_${i}_${['capa','intro','cedinho','armario','lavar','bolinho','cha','passear','tv','varrer','gafanhoto','jantar','lareira','chocolate','capa_fim'][i]}.png`)
    },
    inverno: {
      title: 'Zeco no Inverno',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/inverno/_png/invernocena_${i}_${['capa','intro','acordar','embacada','brincar','pintura','festa','licao','cola','jogando','baralho','gibi','jantar','nanar','capa_fim'][i]}.png`)
    }
  };

  // Register galleries
  Object.keys(books).forEach(k => (window as any).registerGallery('book_' + k, books[k].pages));

  // Book click handlers
  document.querySelectorAll<HTMLElement>('[data-book]').forEach(el => {
    el.addEventListener('click', () => {
      const season = el.dataset.book!;
      const book = books[season];
      (window as any).openGallery('book_' + season, 0, book.title, 'Livro ilustrado');
    });
  });
</script>
