---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import CreatureSection from '../components/CreatureSection/CreatureSection.astro';
import CreatureCard from '../components/CreatureCard/CreatureCard.astro';
import CharacterStrip from '../components/CharacterStrip/CharacterStrip.astro';
import DSMainCard from '../components/DSMainCard/DSMainCard.astro';
import BookGallery from '../components/BookGallery/BookGallery.astro';
import FilterBar from '../components/FilterBar/FilterBar.astro';
import Modal from '../components/Modal/Modal.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { useTranslations } from '../i18n/translations';
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const BOOKS_BASE = join(process.cwd(), 'public', 'imgs', 'books');
const BOOKS_URL = '/imgs/books';
const CHARS_BASE = join(process.cwd(), 'public', 'imgs', 'characters');
const CHARS_URL = '/imgs/characters';

const words = t.common.words;

function translateName(filename: string): string {
  const raw = filename
    .replace(/\.[^.]+$/, '')
    .replace(/_/g, ' ')
    .replace(/^\d+\s*/, '')
    .trim();
  return raw.split(' ').map(w => words[w.toLowerCase()] ?? w).join(' ');
}

function getCharacters(creature: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, creature);
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: translateName(f),
        image: `${CHARS_URL}/${creature}/${f}`,
      }));
  } catch {
    return [];
  }
}

const napcatChars = getCharacters('napcat');
const zecoChars = getCharacters('zeco');
const tayloChars = getCharacters('taylo');
const miscChars = getCharacters('miscelania');

function findCover(dir: string): string | null {
  for (const ext of ['jpg', 'jpeg', 'png', 'webp']) {
    const p = join(dir, `cover.${ext}`);
    if (existsSync(p)) return `cover.${ext}`;
  }
  return null;
}

function getCreatureBooks(creature: string, bookDefs?: { tag: string; title: string }[]) {
  // Se tem definicoes no i18n, usa elas (tag → pasta, title → titulo)
  if (bookDefs && bookDefs.length > 0) {
    return bookDefs.map((def) => {
      const bookDir = join(BOOKS_BASE, creature, def.tag);
      const cover = findCover(bookDir);
      const pagesDir = join(bookDir, 'pages');
      let hasPublishedPages = false;
      try {
        hasPublishedPages = existsSync(pagesDir) && readdirSync(pagesDir).some((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
      } catch {}
      return {
        id: `${creature}-${def.tag}`,
        image: cover ? `${BOOKS_URL}/${creature}/${encodeURIComponent(def.tag)}/${cover}` : undefined,
        alt: def.title,
        label: def.title,
        soon: !hasPublishedPages,
      };
    });
  }
  // Senao, le do filesystem (fallback)
  const creatureDir = join(BOOKS_BASE, creature);
  try {
    return readdirSync(creatureDir)
      .filter((f: string) => {
        try { return statSync(join(creatureDir, f)).isDirectory(); } catch { return false; }
      })
      .filter((f: string) => !f.startsWith('.') && !f.startsWith('_'))
      .sort()
      .map((folder: string) => {
        const bookDir = join(creatureDir, folder);
        const cover = findCover(bookDir);
        const pagesDir = join(bookDir, 'pages');
        let hasPublishedPages = false;
        try {
          hasPublishedPages = existsSync(pagesDir) && readdirSync(pagesDir).some((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
        } catch {}
        return {
          id: `${creature}-${folder}`,
          image: cover ? `${BOOKS_URL}/${creature}/${encodeURIComponent(folder)}/${cover}` : undefined,
          alt: folder.replace(/-/g, ' '),
          label: folder.replace(/-/g, ' '),
          soon: !hasPublishedPages,
        };
      });
  } catch {
    return [];
  }
}

function getBookPages(creature: string, bookId: string): string[] {
  const pagesDir = join(BOOKS_BASE, creature, bookId, 'pages');
  try {
    return readdirSync(pagesDir)
      .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f))
      .sort()
      .map((f: string) => `${BOOKS_URL}/${creature}/${encodeURIComponent(bookId)}/pages/${encodeURIComponent(f)}`);
  } catch {
    return [];
  }
}

const napcatBooks = getCreatureBooks('napcat', (t.bichittos.napcat as any).books);
const zecoBooks = getCreatureBooks('zeco', (t.bichittos.zeco as any).books);
const tayloBooks = getCreatureBooks('taylo', (t.bichittos.taylo as any).books);
const miscBooks = getCreatureBooks('miscelania');

// Build gallery data for client-side (book pages for modal)
const bookIllustrated = t.bichittos.bookIllustrated;
const bookGalleries: Record<string, { title: string; pages: string[] }> = {};
const allBooks = [...napcatBooks, ...zecoBooks, ...tayloBooks, ...miscBooks];
for (const book of allBooks) {
  if (!book.soon && book.id) {
    const [creature, ...rest] = book.id.split('-');
    const bookFolder = rest.join('-');
    const pages = getBookPages(creature, bookFolder);
    if (pages.length > 0) {
      bookGalleries[book.id] = {
        title: book.label,
        pages,
      };
    }
  }
}
---

<!-- HERO -->
<HeroSection
  label={t.bichittos.heroLabel}
  title={t.bichittos.heroTitle}
  description={t.bichittos.heroDesc}
  background="linear-gradient(135deg, #ff6b9d 0%, #ffa751 30%, #ffe259 60%, #6dd5fa 100%)"
>
  <div class="hero-shapes" slot="decorations">
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
    <div class="hero-shape"></div>
  </div>
</HeroSection>

<FilterBar
  target="creature"
  allLabel={locale === 'en' ? 'All' : 'Todos'}
  filters={[
    { id: 'napcat', label: 'NapCat', color: '#b5a2dc', bgColor: '#2a1f4a' },
    { id: 'zeco', label: 'Zeco', color: '#964712', bgColor: '#f57f20' },
    { id: 'taylo', label: 'Taylo', color: '#5d9466', bgColor: '#185b1e' },
    { id: 'miscelania', label: t.bichittos.miscelania.name, color: '#8badc4', bgColor: '#1a2a40' },
  ]}
/>

<!-- NAPCAT -->
<CreatureSection gradient="var(--gradient-napcat-bg)" accentColor="var(--color-napcat-1)" id="napcat">
  <CreatureCard name={t.bichittos.napcat.name} color1="#b5a2dc" color2="#ddd4f4">
    {t.bichittos.napcat.text.map((p) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-napcat)"
      height="1400px"
      maxHeight="80vh"
      titleColor="#4f0a42"
      textColor="#ddd4f4"
      characters={[
        { image: '/imgs/characters/napcat/napcat-sonequinha.png', x: 55, y: 0, size: 360, zIndex: 2 },
        { image: '/imgs/characters/napcat/violeta.png', x: 82, y: 0, size: 350, zIndex: 1 },
      ]}
    >
      <Fragment slot="text">
        <h3>{t.bichittos.napcat.name} & Violeta</h3>
        {t.bichittos.napcat.panel.story.map((p) => <p>{p}</p>)}
      </Fragment>
      <CharacterStrip gradient="var(--gradient-napcat)" characters={napcatChars} />
    </DSMainCard>
  </CreatureCard>
  <BookGallery title={t.bichittos.booksTitle} books={napcatBooks} soonLabel={t.common.soon} />
</CreatureSection>

<!-- ZECO -->
<CreatureSection gradient="var(--gradient-zeco-bg)" accentColor="var(--color-zeco-1)" id="zeco">
  <CreatureCard name={t.bichittos.zeco.name} color1="#964712" color2="#f9e3cf">
    {t.bichittos.zeco.text.map((p) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-zeco)"
      height="1400px"
      maxHeight="80vh"
      titleColor="#f58020"
      textColor="#594733"
      mascot={{ image: '/imgs/characters/zeco/ninha_apaixonada.png', size: 100, offsetX: 15, offsetY: -70,  mobileScale: 0.5, mobileOffsetY: -10 }}
      characters={[
        { image: '/imgs/characters/zeco/zeco_comendo_picole.png', x: 55, y: 0, size: 400, zIndex: 3 },
        { image: '/imgs/characters/zeco/Rui_Merengue_comendo_compota.png', x: 85, y: 0, size: 280, zIndex: 1 },
      ]}
    >
      <Fragment slot="text">
        <h3>{t.bichittos.zeco.name} & Amigos</h3>
        {t.bichittos.zeco.panel.story.map((p) => <p>{p}</p>)}
      </Fragment>
      <CharacterStrip gradient="var(--gradient-zeco)" characters={zecoChars} />
    </DSMainCard>
  </CreatureCard>
  <BookGallery title={t.bichittos.booksTitle} books={zecoBooks} />
</CreatureSection>

<!-- TAYLO -->
<CreatureSection gradient="var(--gradient-taylo-bg)" accentColor="var(--color-taylo-1)" id="taylo">
  <CreatureCard name={t.bichittos.taylo.name} color1="#5d9466" color2="#fff">
    {t.bichittos.taylo.text.map((p) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-taylo)"
      height="1400px"
      maxHeight="80vh"
      titleColor="#d7e2dd"
      textColor="#b6fcc0"
      characters={[
        { image: '/imgs/characters/taylo/taylo.png', x: 80, y: 0, size: 400, zIndex: 3 },
        { image: '/imgs/characters/taylo/pitu.png', x: 55, y: 0, size: 200, zIndex: 2, mobileY: 35 },
        // { image: '/imgs/characters/taylo/Catarina.png', x: 63, y: 0, size: 220, zIndex: 1 },
      ]}
    >
      <Fragment slot="text">
        <h3>{t.bichittos.taylo.name} & Amigos</h3>
        {t.bichittos.taylo.panel.story.map((p) => <p>{p}</p>)}
      </Fragment>
      <CharacterStrip gradient="var(--gradient-taylo)" characters={tayloChars} />
    </DSMainCard>
  </CreatureCard>
  <BookGallery title={t.bichittos.booksTitle} books={tayloBooks} soonLabel={t.common.soon} />
</CreatureSection>

<!-- MISCELANIA -->
<CreatureSection gradient="var(--gradient-misc-bg)" accentColor="var(--color-misc-1)" id="miscelania">
  <CreatureCard name={t.bichittos.miscelania.name} color1="#8badc4" color2="#b0cfe0">
    {t.bichittos.miscelania.text.map((p) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-misc)"
      height="1400px"
      maxHeight="80vh"
      titleColor="#081e28"
      textColor="#b0cfe0"
      characters={[
        { image: '/imgs/characters/miscelania/querie_dancando.gif', x: 55, y: 0, size: 100, zIndex: 2, mobileY: 85, mobileScale: 0.55},
        { image: '/imgs/characters/miscelania/Cheio_Bolinha_voando.png', x: 82, y: 30, size: 200, zIndex: 1, mobileY: 100, mobileScale: 0.70 },
        { image: '/imgs/characters/miscelania/malmo.png', x: 5, y: 0, size: 100, zIndex: 1 },
      ]}
    >
      <Fragment slot="text">
        <h3>{t.bichittos.miscelania.name}</h3>
        {t.bichittos.miscelania.panel.story.map((p) => <p>{p}</p>)}
      </Fragment>
      {miscChars.length > 0 && <CharacterStrip gradient="var(--gradient-misc)" characters={miscChars} />}
    </DSMainCard>
  </CreatureCard>
  {miscBooks.length > 0 && <BookGallery title={t.bichittos.booksTitle} books={miscBooks} soonLabel={t.common.soon} />}
</CreatureSection>

<Modal />
<ScrollReveal selector="[data-creature]" />

<style>
  .hero-shapes {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    background: #fff;
    animation: shapeFloat 6s ease-in-out infinite;
  }

  .hero-shape:nth-child(1) { width: 150px; height: 150px; top: 10%; left: 5%; }
  .hero-shape:nth-child(2) { width: 80px; height: 80px; top: 60%; right: 10%; animation-delay: 2s; border-radius: 30%; }
  .hero-shape:nth-child(3) { width: 100px; height: 100px; bottom: 15%; left: 20%; animation-delay: 1s; }

  .creature-divider {
    width: 40px;
    height: 1px;
    background: var(--color-border);
    margin: 4rem auto;
  }

  @keyframes shapeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }
</style>

<script is:inline define:vars={{ bookGalleries }}>
  // Register book galleries for modal
  document.addEventListener('DOMContentLoaded', () => {
    for (const [id, data] of Object.entries(bookGalleries)) {
      window.registerGallery('book_' + id, data.pages);
    }
  });
</script>

<script is:inline define:vars={{ bookGalleries, bookIllustrated }}>
  window.__bookGalleries = bookGalleries;
  window.__bookIllustrated = bookIllustrated;
</script>

<script>
  // Book click handlers
  document.querySelectorAll<HTMLElement>('[data-book]').forEach(el => {
    el.addEventListener('click', () => {
      const bookId = el.dataset.book!;
      const galleries = (window as any).__bookGalleries;
      const subtitle = (window as any).__bookIllustrated || 'Illustrated book';
      if (!galleries || !galleries[bookId]) return;
      (window as any).openGallery('book_' + bookId, 0, galleries[bookId].title, subtitle);
    });
  });
</script>
