---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import CreatureSection from '../components/CreatureSection/CreatureSection.astro';
import CreatureCard from '../components/CreatureCard/CreatureCard.astro';
import DSMainCard from '../components/DSMainCard/DSMainCard.astro';
import CharacterStrip from '../components/CharacterStrip/CharacterStrip.astro';
import WorldCard from '../components/WorldCard/WorldCard.astro';
import BookGallery from '../components/BookGallery/BookGallery.astro';
import FilterBar from '../components/FilterBar/FilterBar.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { useTranslations } from '../i18n/translations';
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const worlds = [
  { id: 'lunnp1', tag: 'Planeta', name: "LUNN'P1", css: 'wb-lunnp1' },
  { id: 'eni4', tag: 'Planeta', name: 'ENI-4\u0394', css: 'wb-eni4' },
  { id: 'triplec', tag: 'Estação Espacial', name: 'TripleC', css: 'wb-triplec' },
  { id: 'orfv', tag: 'Planeta', name: 'ORF-V', css: 'wb-orfv' },
  { id: 'z1', tag: 'Planeta', name: 'Z1', css: 'wb-z1' },
  { id: 'gotto', tag: 'Planeta', name: 'Gotto', css: 'wb-gotto' },
];

// Kammara characters
const CHARS_BASE = join(process.cwd(), 'public', 'imgs', 'characters');
const CHARS_URL = '/imgs/characters';

function getCharacters(creature: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, creature);
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: f.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' '),
        image: `${CHARS_URL}/${creature}/${f}`,
      }));
  } catch {
    return [];
  }
}

const kammaraChars = getCharacters('kammara');

const BOOKS_BASE = join(process.cwd(), 'public', 'imgs', 'books', 'kammara');
const BOOKS_URL = '/imgs/books/kammara';

function findCover(dir: string): string | null {
  for (const ext of ['jpg', 'jpeg', 'png', 'webp']) {
    const p = join(dir, `cover.${ext}`);
    if (existsSync(p)) return `cover.${ext}`;
  }
  return null;
}

const kammaraBookDefs = (t.kammara.books as any) as { tag: string; title: string }[] || [];
const kammaraBooks = kammaraBookDefs.length > 0
  ? kammaraBookDefs.map((def) => {
      const bookDir = join(BOOKS_BASE, def.tag);
      const cover = findCover(bookDir);
      const pagesDir = join(bookDir, 'pages');
      let hasPublishedPages = false;
      try {
        hasPublishedPages = existsSync(pagesDir) && readdirSync(pagesDir).some((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
      } catch {}
      return {
        id: `kammara-${def.tag}`,
        image: cover ? `${BOOKS_URL}/${encodeURIComponent(def.tag)}/${cover}` : undefined,
        alt: def.title,
        label: def.title,
        soon: !hasPublishedPages,
      };
    })
  : [];
---

<HeroSection
  label={t.kammara.heroLabel}
  title={t.kammara.heroTitle}
  description={t.kammara.heroDesc}
  background="linear-gradient(135deg, #0a0a2e, #1a1a4e, #2d1b69, #0f3460, #0a0a2e)"
  textColor="#fff"
  labelColor="rgba(255,255,255,0.3)"
>
  <Fragment slot="decorations">
    <div class="hero-stars">
      <div class="hero-star"></div><div class="hero-star"></div><div class="hero-star"></div>
      <div class="hero-star"></div><div class="hero-star"></div><div class="hero-star"></div>
    </div>
    <div class="hero-glow"></div>
  </Fragment>
</HeroSection>

{kammaraBooks.length > 0 && <BookGallery title={t.kammara.booksTitle} books={kammaraBooks} soonLabel={t.common.soon} />}

<!-- KAMMARA SECTION -->
<CreatureSection gradient="var(--gradient-kammara)" accentColor="var(--color-kammara-purple)">
  <CreatureCard name={(t.kammara.section as any).name} color1="#b8a9e8" color2="#d4cbf0">
    {(t.kammara.section as any).text.map((p: string) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-kammara)"
      height="1400px"
      maxHeight="80vh"
      titleColor="#b8a9e8"
      textColor="#d4cbf0"
      characters={[]}
    >
      <Fragment slot="text">
        <h3>{(t.kammara.section as any).name}</h3>
        {(t.kammara.section as any).panel.story.map((p: string) => <p>{p}</p>)}
      </Fragment>
      {kammaraChars.length > 0 && <CharacterStrip gradient="var(--gradient-kammara)" characters={kammaraChars} />}
    </DSMainCard>
  </CreatureCard>
</CreatureSection>

<FilterBar
  target="world"
  allLabel={locale === 'en' ? 'All' : 'Todos'}
  filters={worlds.map(w => ({ id: w.id, label: w.name }))}
/>

{worlds.map((world, i) => (
  <WorldCard
    tag={world.tag}
    name={world.name}
    id={world.id}
    gradientClass={world.css}
    showDivider={i < worlds.length - 1}
  >
    <p>{t.kammara.placeholder}</p>
  </WorldCard>
))}

<ScrollReveal selector="[data-world]" />
<ScrollReveal selector="[data-creature]" />

<style>
  :global(.hero) {
    background-size: 400% 400%;
    animation: fluidCosmos 20s ease-in-out infinite;
  }

  .hero-stars {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    animation: twinkle 4s ease-in-out infinite;
  }

  .hero-star:nth-child(1) { width: 2px; height: 2px; top: 10%; left: 15%; }
  .hero-star:nth-child(2) { width: 3px; height: 3px; top: 20%; left: 70%; animation-delay: 1s; }
  .hero-star:nth-child(3) { width: 1.5px; height: 1.5px; top: 35%; left: 40%; animation-delay: 2s; }
  .hero-star:nth-child(4) { width: 2px; height: 2px; top: 50%; left: 85%; animation-delay: 0.5s; }
  .hero-star:nth-child(5) { width: 2.5px; height: 2.5px; top: 65%; left: 25%; animation-delay: 3s; }
  .hero-star:nth-child(6) { width: 2px; height: 2px; top: 80%; left: 60%; animation-delay: 1.5s; }

  .hero-glow {
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100,80,200,0.15) 0%, transparent 70%);
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    animation: glowPulse 8s ease-in-out infinite;
    filter: blur(20px);
    pointer-events: none;
  }

  @keyframes fluidCosmos {
    0% { background-position: 0% 50%; }
    25% { background-position: 75% 0%; }
    50% { background-position: 100% 50%; }
    75% { background-position: 25% 100%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  @keyframes glowPulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.5; }
    50% { transform: translateX(-50%) scale(1.3); opacity: 0.8; }
  }
</style>
