---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import CreatureSection from '../components/CreatureSection/CreatureSection.astro';
import CreatureCard from '../components/CreatureCard/CreatureCard.astro';
import DSMainCard from '../components/DSMainCard/DSMainCard.astro';
import CharacterStrip from '../components/CharacterStrip/CharacterStrip.astro';
import SubSystem from '../components/SubSystem/SubSystem.astro';
import SoonPanel from '../components/SoonPanel/SoonPanel.astro';
import BookGallery from '../components/BookGallery/BookGallery.astro';
import FilterBar from '../components/FilterBar/FilterBar.astro';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal.astro';
import { useTranslations } from '../i18n/translations';
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props { locale?: string; }
const { locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);

const worlds = [
  { id: 'lunnp1', tag: 'Planeta', name: "LUNN'P1", color: 'var(--color-lunnp1-1)', bgColor: 'var(--color-lunnp1-dark)', color1: 'var(--color-lunnp1-1)', color2: 'var(--color-lunnp1-3)', gradient: 'var(--gradient-lunnp1)', accentColor: 'var(--color-lunnp1-1)', titleColor: 'var(--color-lunnp1-2)', textColor: 'var(--color-lunnp1-text)', subtitleColor: 'var(--color-lunnp1-4)', labelColor: 'var(--color-lunnp1-6)' },
  { id: 'eni4', tag: 'Planeta', name: 'ENI-4\u0394', color: 'var(--color-eni4-1)', bgColor: 'var(--color-eni4-dark)', color1: 'var(--color-eni4-1)', color2: 'var(--color-eni4-3)', gradient: 'var(--gradient-eni4)', accentColor: 'var(--color-eni4-1)', titleColor: 'var(--color-eni4-2)', textColor: 'var(--color-eni4-text)', subtitleColor: 'var(--color-eni4-4)', labelColor: 'var(--color-eni4-6)' },
  { id: 'triplec', tag: 'Estação Espacial', name: 'TripleC', color: 'var(--color-triplec-1)', bgColor: 'var(--color-triplec-dark)', color1: 'var(--color-triplec-4)', color2: 'var(--color-triplec-3)', gradient: 'var(--gradient-triplec)', accentColor: 'var(--color-triplec-1)', titleColor: 'var(--color-triplec-2)', textColor: 'var(--color-triplec-text)', subtitleColor: 'var(--color-triplec-4)', labelColor: 'var(--color-triplec-6)' },
  { id: 'orfv', tag: 'Planeta', name: 'ORF-V', color: 'var(--color-orfv-1)', bgColor: 'var(--color-orfv-dark)', color1: 'var(--color-orfv-4)', color2: 'var(--color-orfv-3)', gradient: 'var(--gradient-orfv)', accentColor: 'var(--color-orfv-1)', titleColor: 'var(--color-orfv-2)', textColor: 'var(--color-orfv-text)', subtitleColor: 'var(--color-orfv-4)', labelColor: 'var(--color-orfv-6)', bgOpacity: 0.4 },
  { id: 'z1', tag: 'Planeta', name: 'Z1', color: 'var(--color-z1-1)', bgColor: 'var(--color-z1-dark)', color1: 'var(--color-z1-1)', color2: 'var(--color-z1-3)', gradient: 'var(--gradient-z1)', accentColor: 'var(--color-z1-1)', titleColor: 'var(--color-z1-2)', textColor: 'var(--color-z1-text)', subtitleColor: 'var(--color-z1-4)', labelColor: 'var(--color-z1-6)' },
  { id: 'gotto', tag: 'Planeta', name: 'Gotto', color: 'var(--color-gotto-1)', bgColor: 'var(--color-gotto-dark)', color1: 'var(--color-gotto-1)', color2: 'var(--color-gotto-3)', gradient: 'var(--gradient-gotto)', accentColor: 'var(--color-gotto-1)', titleColor: 'var(--color-gotto-2)', textColor: 'var(--color-gotto-text)', subtitleColor: 'var(--color-gotto-4)', labelColor: 'var(--color-gotto-6)' },
];

// Kammara characters
const CHARS_BASE = join(process.cwd(), 'public', 'imgs', 'characters');
const CHARS_URL = '/imgs/characters';

const words = t.common.words;

function cleanName(filename: string): string {
  const raw = filename
    .replace(/\.[^.]+$/, '')     // remove extensão
    .replace(/_/g, ' ')          // underscores viram espaço
    .replace(/^\d+\s*/, '')      // remove números do início
    .trim();
  return raw.split(' ').map(w => words[w.toLowerCase()] ?? w).join(' ');
}

function getCharacters(creature: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, creature);
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: cleanName(f),
        image: `${CHARS_URL}/${creature}/${f}`,
      }));
  } catch {
    return [];
  }
}

const kammaraChars = getCharacters('kammara');
// Bg for main Kammara section
const kammaraBgDir = join(CHARS_BASE, 'kammara', '_bg');
let kammaraBg: string | null = null;
try {
  const bgFile = readdirSync(kammaraBgDir).find((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
  if (bgFile) kammaraBg = `${CHARS_URL}/kammara/_bg/${bgFile}`;
} catch {}

function getWorldCharacters(worldId: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, 'kammara', worldId);
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: cleanName(f),
        image: `${CHARS_URL}/kammara/${worldId}/${f}`,
      }));
  } catch {
    return [];
  }
}

function getWorldScenes(worldId: string): { name: string; image: string }[] {
  const dir = join(CHARS_BASE, 'kammara', worldId, '_scenes');
  try {
    return readdirSync(dir)
      .filter((f: string) => /\.(png|jpg|jpeg|gif|webp|apng)$/i.test(f))
      .sort()
      .map((f: string) => ({
        name: cleanName(f),
        image: `${CHARS_URL}/kammara/${worldId}/_scenes/${f}`,
      }));
  } catch {
    return [];
  }
}

function getSubsystemImages(worldId: string): (string | null)[] {
  const dir = join(CHARS_BASE, 'kammara', worldId, '_subsystems');
  try {
    const files = readdirSync(dir).filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f)).sort();
    return [0, 1, 2].map(i => {
      const file = files.find((f: string) => f.startsWith(`${i}.`) || f.startsWith(`${i}-`));
      return file ? `${CHARS_URL}/kammara/${worldId}/_subsystems/${file}` : null;
    });
  } catch {
    return [null, null, null];
  }
}

function getWorldBg(worldId: string): string | null {
  const bgDir = join(CHARS_BASE, 'kammara', worldId, '_bg');
  try {
    const file = readdirSync(bgDir).find((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
    return file ? `${CHARS_URL}/kammara/${worldId}/_bg/${file}` : null;
  } catch {
    return null;
  }
}

const BOOKS_BASE = join(process.cwd(), 'public', 'imgs', 'books', 'kammara');
const BOOKS_URL = '/imgs/books/kammara';

function findCover(dir: string): string | null {
  for (const ext of ['jpg', 'jpeg', 'png', 'webp']) {
    const p = join(dir, `cover.${ext}`);
    if (existsSync(p)) return `cover.${ext}`;
  }
  return null;
}

const kammaraBookDefs = ((t.kammara.section as any).books as { tag: string; title: string }[]) || [];
const kammaraBooks = kammaraBookDefs.length > 0
  ? kammaraBookDefs.map((def) => {
      const bookDir = join(BOOKS_BASE, def.tag);
      const cover = findCover(bookDir);
      const pagesDir = join(bookDir, 'pages');
      let hasPublishedPages = false;
      try {
        hasPublishedPages = existsSync(pagesDir) && readdirSync(pagesDir).some((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f));
      } catch {}
      return {
        id: `kammara-${def.tag}`,
        image: cover ? `${BOOKS_URL}/${encodeURIComponent(def.tag)}/${cover}` : undefined,
        alt: def.title,
        label: def.title,
        soon: !hasPublishedPages,
      };
    })
  : [];

// Pre-compute world data for template
const kammaraWorlds = (t.kammara as any).worlds || {};
const worldsData = worlds.map((world) => ({
  ...world,
  texts: (kammaraWorlds[world.id]?.text || []) as string[],
  panelStory: (kammaraWorlds[world.id]?.panel?.story || []) as string[],
  worldName: (kammaraWorlds[world.id]?.name || world.name) as string,
  chars: getWorldCharacters(world.id),
  scenes: getWorldScenes(world.id),
  bgImage: getWorldBg(world.id),
  subsystems: (kammaraWorlds[world.id]?.subsystems || []) as { title: string; text: string[] }[],
  subsystemImages: getSubsystemImages(world.id),
}));
---

<HeroSection
  label={t.kammara.heroLabel}
  title={t.kammara.heroTitle}
  description={t.kammara.heroDesc}
  background="linear-gradient(135deg, #0a0a2e, #1a1a4e, #2d1b69, #0f3460, #0a0a2e)"
  textColor="#fff"
  labelColor="rgba(255,255,255,0.3)"
>
  <Fragment slot="decorations">
    <div class="hero-stars-field"></div>
    <div class="hero-stars-field hero-stars-field-2"></div>
    <div class="hero-glow"></div>
  </Fragment>
</HeroSection>

<FilterBar
  target="creature"
  allLabel={locale === 'en' ? 'All' : 'Todos'}
  filters={[
    { id: 'kammara', label: (t.kammara.section as any).name, color: '#b8a9e8', bgColor: '#0a0a2e' },
    ...worlds.map(w => ({ id: w.id, label: w.name, color: w.color, bgColor: w.bgColor })),
  ]}
/>

<!-- KAMMARA SECTION -->
<CreatureSection gradient="var(--gradient-kammara)" accentColor="var(--color-kammara-purple)" id="kammara" {...(kammaraBg ? { bgImage: kammaraBg } : {})}>
  <div class="kammara-stars" id="kammara-stars" data-parallax-stars></div>
  <CreatureCard name={(t.kammara.section as any).name} color1="var(--color-kammara-1)" color2="var(--color-kammara-2)">
    {(t.kammara.section as any).text.map((p: string) => <p>{p}</p>)}
    <DSMainCard
      slot="banner"
      gradient="var(--gradient-kammara-card)"
      height="1400px"
      maxHeight="80vh"
      titleColor="var(--color-kammara-1)"
      textColor="var(--color-kammara-2)"
      characters={[]}
      stripSide
      bgOpacity={0.3}
    >
      <Fragment slot="text">
        <h2>{(t.kammara.section as any).name}</h2>
        {(t.kammara.section as any).panel.story.map((p: string) => <p>{p}</p>)}
      </Fragment>
      {kammaraChars.length > 0 ? (
        <CharacterStrip gradient="var(--gradient-kammara)" characters={kammaraChars} cardSize={300} noFloat speed={120} transparent />
      ) : (
        <SoonPanel label={t.common.soon} />
      )}
    </DSMainCard>
  </CreatureCard>
  {kammaraBooks.length > 0 && <BookGallery title={t.kammara.booksTitle} books={kammaraBooks} soonLabel={t.common.soon} />}
</CreatureSection>

{worldsData.map((w) => (
  <CreatureSection gradient={`var(--gradient-${w.id}-bg)`} accentColor={w.accentColor} id={w.id} {...(w.bgImage ? { bgImage: w.bgImage } : {})}>
    <CreatureCard name={w.worldName} color1={w.color1} color2={w.color2}>
      {w.texts.length > 0 ? w.texts.map((p: string) => <p>{p}</p>) : <p>{t.kammara.placeholder}</p>}
      <DSMainCard
        slot="banner"
        gradient={w.gradient}
        height="1400px"
        maxHeight="80vh"
        titleColor={w.titleColor}
        textColor={w.textColor}
        subtitleColor={(w as any).subtitleColor}
        characters={[]}
        stripSide
        bgOpacity={(w as any).bgOpacity ?? (w.bgImage ? 0.6 : 1)}
      >
        <Fragment slot="text">
          <h2>{w.worldName}</h2>
          {w.panelStory.map((p: string) =>
            p.startsWith('### ') ? <h3>{p.slice(4)}</h3> :
            p.startsWith('## ') ? <h2>{p.slice(3)}</h2> :
            <p>{p}</p>
          )}
        </Fragment>
        {w.chars.length > 0 ? (
          <CharacterStrip gradient={w.gradient} characters={w.chars} cardSize={300} noFloat speed={100} transparent labelColor={w.labelColor} />
        ) : (
          <SoonPanel label={t.common.soon} color={w.color} />
        )}
      </DSMainCard>
    </CreatureCard>
    {w.scenes.length > 0 && (
      <div class="scenes-strip">
        <CharacterStrip gradient={w.gradient} characters={w.scenes} cardSize={300} noFloat speed={300} transparent noBorder noLoop showArrows arrowColor={w.titleColor} sectionTitle={(t.kammara as any).scenesTitle} labelColor={w.labelColor} />
      </div>
    )}
    {w.subsystems.filter((s) => s.text.length > 0 && !s.text[0].startsWith('Placeholder')).length > 0 && (
      <SubSystem
          sectionTitle={(t.kammara as any).subsystemsTitle}
          cards={w.subsystems
            .map((s, i) => ({
              title: s.title,
              image: w.subsystemImages[i] || undefined,
              imageAlt: s.title,
              texts: s.text,
            }))
            .filter((c) => c.texts.length > 0 && !c.texts[0].startsWith('Placeholder'))}
          titleColor={w.titleColor}
          subtitleColor={(w as any).subtitleColor}
          textColor={w.textColor}
          gradient={w.gradient}
        />
    )}
  </CreatureSection>
))}

<ScrollReveal selector="[data-creature]" />

<style is:global>
  .strips-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    height: 100%;
  }

  .strips-stack .char-strip {
    position: relative;
    top: auto;
    flex: 1;
  }

  .scenes-strip {
    padding: 0;
  }

  .scenes-strip :global(.char-strip-wrap) {
    width: 100%;
  }

  .scenes-strip :global(.char-strip) {
    position: relative;
    top: auto;
    overflow: hidden;
  }

  .scenes-strip :global(.char-strip-track) {
    justify-content: center;
  }

  .scenes-strip :global(.strip-section-title) {
    padding: 0 2rem;
  }
</style>

<script>
  const canvas = document.getElementById('kammara-stars');
  if (canvas) {
    const section = canvas.closest('[data-section-creature="kammara"]') as HTMLElement;
    if (section) {
    const w = section.offsetWidth;
    const h = section.offsetHeight;
    const count = 250;
    const shadows: string[] = [];
    for (let i = 0; i < count; i++) {
      const x = Math.floor(Math.random() * w);
      const y = Math.floor(Math.random() * h);
      const opacity = (0.2 + Math.random() * 0.6).toFixed(2);
      const blur = Math.random() < 0.1 ? '1px' : '0';
      shadows.push(`${x}px ${y}px ${blur} rgba(255,255,255,${opacity})`);
    }
    canvas.style.boxShadow = shadows.join(',');

    // Parallax: estrelas movem mais devagar que o conteúdo
    function updateStarsParallax() {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom > -200 && rect.top < vh + 200) {
        const progress = (vh - rect.top) / (vh + rect.height);
        const offset = (progress - 0.5) * 80;
        canvas.style.transform = `translateY(${offset}px)`;
      }
      requestAnimationFrame(updateStarsParallax);
    }
    requestAnimationFrame(updateStarsParallax);
    }
  }
</script>

<style>
  :global(#kammara-stars) {
    position: absolute;
    top: -20%;
    left: 0;
    width: 1px;
    height: 1px;
    z-index: 1;
    pointer-events: none;
    animation: twinkleField 8s ease-in-out infinite;
  }

  :global(.hero) {
    background-size: 400% 400%;
    animation: fluidCosmos 20s ease-in-out infinite;
  }

  .hero-stars-field {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
    background: transparent;
    box-shadow:
      25px 15px #fff, 80px 40px #fff, 150px 20px rgba(255,255,255,0.8),
      200px 60px #fff, 320px 30px rgba(255,255,255,0.6), 400px 80px #fff,
      50px 90px rgba(255,255,255,0.5), 180px 110px #fff, 280px 95px rgba(255,255,255,0.7),
      350px 120px #fff, 450px 50px rgba(255,255,255,0.4), 500px 100px #fff,
      30px 140px rgba(255,255,255,0.6), 120px 160px #fff, 250px 150px rgba(255,255,255,0.5),
      380px 170px #fff, 480px 140px rgba(255,255,255,0.8), 550px 160px #fff,
      70px 200px #fff, 160px 220px rgba(255,255,255,0.6), 300px 210px #fff,
      420px 230px rgba(255,255,255,0.7), 520px 200px #fff, 600px 220px rgba(255,255,255,0.5),
      90px 250px rgba(255,255,255,0.4), 210px 270px #fff, 340px 260px rgba(255,255,255,0.8),
      460px 280px #fff, 580px 250px rgba(255,255,255,0.6), 650px 270px #fff,
      40px 300px #fff, 130px 320px rgba(255,255,255,0.5), 270px 310px #fff,
      390px 330px rgba(255,255,255,0.7), 510px 300px #fff, 630px 320px rgba(255,255,255,0.4),
      700px 50px rgba(255,255,255,0.6), 750px 120px #fff, 800px 200px rgba(255,255,255,0.5),
      850px 80px #fff, 900px 160px rgba(255,255,255,0.7), 950px 240px #fff,
      720px 300px rgba(255,255,255,0.4), 780px 30px #fff, 830px 280px rgba(255,255,255,0.6);
    animation: twinkleField 6s ease-in-out infinite;
  }

  .hero-stars-field-2 {
    box-shadow:
      60px 35px rgba(255,255,255,0.5), 140px 70px #fff, 230px 45px rgba(255,255,255,0.7),
      310px 85px #fff, 410px 55px rgba(255,255,255,0.4), 490px 75px #fff,
      100px 130px rgba(255,255,255,0.6), 190px 145px #fff, 290px 125px rgba(255,255,255,0.8),
      370px 155px #fff, 460px 135px rgba(255,255,255,0.5), 540px 150px #fff,
      75px 190px #fff, 170px 205px rgba(255,255,255,0.7), 260px 195px #fff,
      360px 215px rgba(255,255,255,0.4), 440px 190px #fff, 530px 210px rgba(255,255,255,0.6),
      110px 260px rgba(255,255,255,0.5), 200px 275px #fff, 330px 265px rgba(255,255,255,0.8),
      430px 285px #fff, 520px 260px rgba(255,255,255,0.6), 610px 280px #fff,
      680px 100px rgba(255,255,255,0.5), 740px 180px #fff, 810px 130px rgba(255,255,255,0.7),
      870px 220px #fff, 930px 100px rgba(255,255,255,0.4), 760px 260px #fff;
    animation: twinkleField 6s ease-in-out infinite;
    animation-delay: -3s;
  }

  .hero-glow {
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100,80,200,0.15) 0%, transparent 70%);
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    animation: glowPulse 8s ease-in-out infinite;
    filter: blur(20px);
    pointer-events: none;
  }

  @keyframes fluidCosmos {
    0% { background-position: 0% 50%; }
    25% { background-position: 75% 0%; }
    50% { background-position: 100% 50%; }
    75% { background-position: 25% 100%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes twinkleField {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  @keyframes glowPulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.5; }
    50% { transform: translateX(-50%) scale(1.3); opacity: 0.8; }
  }
</style>
