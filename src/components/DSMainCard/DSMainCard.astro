---
/**
 * DSMainCard — Cena animada fullwidth que substitui o banner JPG
 *
 * Os personagens sao posicionados como PNGs individuais dentro da cena,
 * igual ao banner original mas com imagens separadas e potencial pra animacao.
 *
 * Props:
 *   characters: array de { image, x, y, size, zIndex? }
 *   gradient: CSS gradient para o fundo da cena
 *   height: altura do card (default '50vh')
 *   maxHeight: altura maxima (default '80vh')
 */

interface Character {
  image: string;
  x: number;
  y: number;
  size: number;
  zIndex?: number;
}

interface Props {
  characters: Character[];
  gradient?: string;
  height?: string;
  maxHeight?: string;
}

const {
  characters,
  gradient = 'var(--gradient-bichittos)',
  height = '50vh',
  maxHeight = '80vh',
} = Astro.props;
---

<div class="ds-card" style={`height: ${height}; max-height: ${maxHeight};`}>
  <div class="ds-card-bg" style={`background: ${gradient};`}></div>
  <div class="ds-card-scene">
    {characters.map((c) => (
      <div
        class="ds-char"
        style={`
          left: ${c.x}%;
          top: ${c.y}%;
          width: ${c.size}px;
          height: ${c.size}px;
          z-index: ${c.zIndex || 1};
        `}
      >
        <img src={c.image} alt="" />
      </div>
    ))}
  </div>
  <slot />
</div>

<style>
  .ds-card {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    position: relative;
    overflow: hidden;
    margin-top: 2.5rem;
  }

  .ds-card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ds-card-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ds-char {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .ds-char img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));
  }

  @media (max-width: 768px) {
    .ds-card {
      height: 35vh !important;
      min-height: 250px;
    }

    .ds-char {
      transform: translate(-50%, -50%) scale(0.7);
    }
  }
</style>
