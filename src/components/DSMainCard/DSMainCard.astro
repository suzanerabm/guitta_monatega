---
/**
 * DSMainCard — Cena fullwidth que substitui o banner JPG
 *
 * Props:
 *   characters: array de { image, x, y, size, zIndex? }
 *   gradient: CSS gradient para o fundo
 *   height/maxHeight: dimensoes
 *   titleColor/textColor: cores do painel de texto
 */
import DSTextPanel from '../DSTextPanel/DSTextPanel.astro';

interface Character {
  image: string;
  x: number;
  y: number;
  size: number;
  zIndex?: number;
}

interface Props {
  characters: Character[];
  gradient?: string;
  height?: string;
  maxHeight?: string;
  titleColor?: string;
  textColor?: string;
}

const {
  characters,
  gradient = 'var(--gradient-bichittos)',
  height = '50vh',
  maxHeight = '80vh',
  titleColor,
  textColor,
} = Astro.props;

const hasText = Astro.slots.has('text');
---

<div class="ds-card" style={`height: ${height}; max-height: ${maxHeight};`}>
  <div class="ds-card-bg" style={`background: ${gradient};`}></div>

  <div class="ds-card-scene">
    {characters.map((c) => (
      <div
        class="ds-char"
        style={`
          left: ${c.x}%;
          bottom: ${c.y}%;
          width: ${c.size}px;
          height: ${c.size}px;
          z-index: ${c.zIndex || 1};
        `}
      >
        <img src={c.image} alt="" />
      </div>
    ))}
  </div>

  {hasText && (
    <div class="ds-text-wrap">
      <DSTextPanel titleColor={titleColor} textColor={textColor}>
        <slot name="text" />
      </DSTextPanel>
    </div>
  )}

  <slot />
</div>

<style>
  .ds-card {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    position: relative;
    overflow: hidden;
    margin-top: 2.5rem;
  }

  .ds-card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ds-card-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ds-char {
    position: absolute;
    transform: translateX(-50%);
  }

  .ds-char img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));
  }

  .ds-text-wrap {
    position: absolute;
    left: 5rem;
    top: 240px;
    bottom: 4rem;
    width: 30%;
    max-width: 380px;
    z-index: 3;
  }

  @media (max-width: 768px) {
    .ds-card {
      height: 35vh !important;
      min-height: 250px;
    }

    .ds-char {
      transform: translateX(-50%) scale(0.7);
    }

    .ds-text-wrap {
      left: 1rem;
      right: 1rem;
      width: auto;
      max-width: none;
      top: 180px;
      bottom: 2rem;
    }
  }
</style>
