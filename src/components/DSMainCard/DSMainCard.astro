---
/**
 * DSMainCard — Cena fullwidth que substitui o banner JPG
 *
 * Props:
 *   characters: array de { image, x, y, size, zIndex? }
 *   gradient: CSS gradient para o fundo
 *   height/maxHeight: dimensoes
 *   textColor: cor do texto no bloco lateral (default branco)
 */

interface Character {
  image: string;
  x: number;
  y: number;
  size: number;
  zIndex?: number;
}

interface Props {
  characters: Character[];
  gradient?: string;
  height?: string;
  maxHeight?: string;
  titleColor?: string;
  textColor?: string;
}

const {
  characters,
  gradient = 'var(--gradient-bichittos)',
  height = '50vh',
  maxHeight = '80vh',
  titleColor = 'rgba(255,255,255,0.9)',
  textColor = 'rgba(255,255,255,0.7)',
} = Astro.props;

const hasText = Astro.slots.has('text');
---

<div class="ds-card" style={`height: ${height}; max-height: ${maxHeight};`}>
  <div class="ds-card-bg" style={`background: ${gradient};`}></div>

  <!-- Personagens -->
  <div class="ds-card-scene">
    {characters.map((c) => (
      <div
        class="ds-char"
        style={`
          left: ${c.x}%;
          bottom: ${c.y}%;
          width: ${c.size}px;
          height: ${c.size}px;
          z-index: ${c.zIndex || 1};
        `}
      >
        <img src={c.image} alt="" />
      </div>
    ))}
  </div>

  <!-- Bloco de texto lateral -->
  {hasText && (
    <div class="ds-text-wrap">
      <div class="ds-text-card">
        <div class="ds-text-scroll" style={`--ds-title-color: ${titleColor}; --ds-text-color: ${textColor};`}>
          <slot name="text" />
        </div>
      </div>
    </div>
  )}

  <slot />
</div>

<style>
  .ds-card {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    position: relative;
    overflow: hidden;
    margin-top: 2.5rem;
  }

  .ds-card-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ds-card-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ds-char {
    position: absolute;
    transform: translateX(-50%);
  }

  .ds-char img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));
  }

  /* Bloco de texto lateral esquerdo */
  .ds-text-wrap {
    position: absolute;
    left: 5rem;
    top: 240px;
    bottom: 4rem;
    width: 30%;
    max-width: 380px;
    z-index: 3;
  }

  .ds-text-card {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: transparent;
    outline: 2px solid rgba(255,255,255,0.2);
    outline-offset: 3px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  }

  .ds-text-scroll {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2rem 1.5rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: var(--weight-light);
    mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .ds-text-scroll::-webkit-scrollbar {
    display: none;
  }

  .ds-text-scroll :global(h3) {
    font-size: 1.3rem;
    font-weight: var(--weight-bold);
    margin-bottom: 0.8rem;
    color: var(--ds-title-color);
  }

  .ds-text-scroll :global(p) {
    margin-bottom: 0.8rem;
    color: var(--ds-text-color);
  }

  @media (max-width: 768px) {
    .ds-card {
      height: 35vh !important;
      min-height: 250px;
    }

    .ds-char {
      transform: translateX(-50%) scale(0.7);
    }

    .ds-text-wrap {
      left: 1rem;
      right: 1rem;
      width: auto;
      max-width: none;
      height: 60%;
    }
  }
</style>
