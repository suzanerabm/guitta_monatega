---
interface Props {
  gradient: string;
  accentColor?: string;
  id?: string;
  bgImage?: string;
  noParallax?: boolean;
}

const { gradient, accentColor, id, bgImage, noParallax = false } = Astro.props;
---

<section class={`creature-section ${bgImage ? 'has-bg-image' : ''} ${noParallax ? 'no-parallax' : ''}`} {...(!noParallax ? { 'data-parallax-section': '' } : {})} {...(id ? { [`data-section-creature`]: id } : {})}>
  <div class="creature-section-bg" style={`background: ${gradient};`}></div>
  {bgImage && (
    <div class="creature-section-bg-image" data-parallax-bg>
      <img src={bgImage} alt="" loading="lazy" decoding="async" />
    </div>
  )}
  {accentColor && (
    <div class="creature-section-glow" style={`background: radial-gradient(ellipse at 30% 20%, ${accentColor}15 0%, transparent 70%);`}></div>
  )}
  <div class="creature-section-content">
    <slot />
  </div>
</section>

<style>
  .creature-section {
    position: relative;
    overflow: hidden;
    transition: opacity 0.4s ease, max-height 0.5s ease;
  }

  .creature-section.hidden {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  .creature-section-bg {
    position: absolute;
    inset: -40% 0;
    z-index: 0;
  }

  .no-parallax .creature-section-bg {
    inset: 0;
  }

  .creature-section-bg-image {
    position: absolute;
    inset: -20% 0;
    z-index: 0;
  }

  .no-parallax .creature-section-bg-image {
    inset: 0;
  }

  .creature-section-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .creature-section-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .creature-section-content {
    position: relative;
    z-index: 1;
    padding: 2rem 0;
  }

  /* Creature name and text colors come from CreatureCard's --c1/--c2/--c3 props */

  .creature-section :global(.creature-divider) {
    background: var(--color-outline-soft);
  }

  .creature-section :global(.book-gallery-title) {
    color: rgba(255,255,255,0.4); /* no exact token — between dim(0.5) and label(0.25) */
  }

  .creature-section :global(.book-cover-label) {
    background: var(--color-bg-overlay);
    color: var(--color-text-overlay);
  }

  .creature-section :global(.book-soon-label) {
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .creature-section-content {
      padding: 1rem 0;
    }
  }
</style>

<script>
  function initParallax() {
    const sections = document.querySelectorAll<HTMLElement>('[data-parallax-section]');

    function update() {
      const vh = window.innerHeight;
      sections.forEach(section => {
        const rect = section.getBoundingClientRect();
        // Skip sections not near viewport
        if (rect.bottom < -200 || rect.top > vh + 200) return;
        const bg = section.querySelector<HTMLElement>('.creature-section-bg');
        const bgImg = section.querySelector<HTMLElement>('.creature-section-bg-image');
        if (!bg) return;
        const progress = (vh - rect.top) / (vh + rect.height);
        const offset = (progress - 0.5) * 100;
        bg.style.transform = `translateY(${offset}%)`;
        if (bgImg) bgImg.style.transform = `translateY(${offset * 0.5}%)`;
      });
      requestAnimationFrame(update);
    }

    requestAnimationFrame(update);
  }

  initParallax();
</script>
