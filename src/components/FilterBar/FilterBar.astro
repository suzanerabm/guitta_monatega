---
interface FilterItem {
  id: string;
  label: string;
}

interface Props {
  filters: FilterItem[];
  allLabel?: string;
  target?: string;
}

const { filters, allLabel = 'Todos', target = 'art' } = Astro.props;
---

<nav class="filter-bar" data-filter-bar={target}>
  <button class="filter-btn active" data-filter="all">{allLabel}</button>
  {filters.map((f) => (
    <button class="filter-btn" data-filter={f.id}>{f.label}</button>
  ))}
</nav>

<style>
  .filter-bar {
    position: sticky;
    top: 92px;
    z-index: 98;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    background: var(--overlay-light);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .filter-btn {
    font-family: 'Fira Sans', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-ink-muted);
    color: var(--color-ink);
  }

  .filter-btn.active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .filter-bar {
      top: 60px;
      gap: 0.35rem;
      padding: 0.6rem 1rem;
    }
    .filter-btn {
      font-size: 0.65rem;
      padding: 0.3rem 0.7rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-filter-bar]').forEach(bar => {
    const target = bar.dataset.filterBar || 'art';
    const btns = bar.querySelectorAll<HTMLElement>('.filter-btn');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter || 'all';
        const sections = document.querySelectorAll<HTMLElement>(`[data-section-${target}]`);
        sections.forEach(el => {
          const id = el.getAttribute(`data-section-${target}`);
          if (filter === 'all' || id === filter) {
            el.classList.remove('hidden');
            el.classList.add('visible');
          } else {
            el.classList.add('hidden');
            el.classList.remove('visible');
          }
        });
      });
    });
  });
</script>
