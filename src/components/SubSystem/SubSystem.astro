---
/**
 * SubSystem — Grid de 3 cards
 * Cada card tem: titulo, foto (esquerda), textos (direita)
 */

interface SubSystemCard {
  title: string;
  image?: string;
  imageAlt?: string;
  texts: string[];
}

interface Props {
  cards: SubSystemCard[];
  titleColor?: string;
  subtitleColor?: string;
  textColor?: string;
  gradient?: string;
  sectionTitle?: string;
}

const { cards, titleColor = 'var(--color-text-overlay-bright)', subtitleColor, textColor = 'var(--color-text-overlay)', gradient, sectionTitle } = Astro.props;
---

{sectionTitle && (
  <h2 class="subsystem-section-title" style={`color: ${titleColor};`}>{sectionTitle}</h2>
)}
<div class="subsystem-grid">
  {cards.map((card) => (
    <div class="subsystem-card" style={gradient ? `--sub-bg: ${gradient};` : ''}>
      <h6 class="subsystem-title" style={`color: ${subtitleColor || titleColor};`}>{card.title}</h6>
      <div class={`subsystem-body ${card.image ? '' : 'no-image'}`}>
        {card.image && (
          <div class="subsystem-image">
            <img src={card.image} alt={card.imageAlt || card.title} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="subsystem-text" style={`color: ${textColor};`}>
          {card.texts.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .subsystem-section-title {
    display: block;
    font-family: var(--sans);
    font-size: var(--size-section);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
    padding: 0 2rem;
    margin: 5em 0 0.5rem;
  }

  .subsystem-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.5rem 2rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: 0;
    margin-bottom: 5rem;
  }

  .subsystem-card {
    flex: 1 1 calc(33.333% - 1rem);
    min-width: 280px;
    border-radius: 16px;
    outline: 2px solid var(--color-outline-mid);
    outline-offset: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 400px;
    position: relative;
  }

  .subsystem-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--sub-bg);
    opacity: 0.2;
    z-index: 0;
    border-radius: 16px;
  }

  .subsystem-title,
  .subsystem-body {
    position: relative;
    z-index: 1;
  }

  .subsystem-title {
    display: block;
    font-size: var(--size-label);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    padding: 1.2rem 1.5rem 0.8rem;
    font-weight: 600;
  }

  .subsystem-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
    min-height: 0;
    overflow: hidden;
  }

  .subsystem-image {
    flex: none;
    height: 200px;
    overflow: hidden;
  }

  .subsystem-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .subsystem-text {
    flex: 1;
    padding: 1rem 1.5rem 1.5rem;
    font-family: var(--sans);
    font-size: var(--size-base);
    line-height: 1.6;
    font-weight: 300;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .subsystem-text::-webkit-scrollbar {
    display: none;
  }

  .subsystem-text :global(p) {
    margin-bottom: 0.6rem;
  }

  @media (min-width: 769px) and (max-width: 1899px) {
    .subsystem-card {
      height: 500px;
    }
  }

  @media (min-width: 1900px) {
    .subsystem-section-title {
      font-size: var(--size-h3);
    }

    .subsystem-body {
      flex-direction: row;
    }

    .subsystem-image {
      flex: 0 0 45%;
      height: auto;
    }

    .subsystem-card {
      height: 550px;
    }

    .subsystem-title {
      font-size: var(--size-md);
      padding: 1.5rem 2rem 1rem;
    }

    .subsystem-text {
      font-size: var(--size-lg);
      padding: 1.5rem 2rem 2rem;
      line-height: 1.7;
    }
  }

  @media (max-width: 768px) {
    .subsystem-section-title {
      padding: 0 2rem;
      margin: 2em 0 0.5rem;
    }

    .subsystem-grid {
      flex-direction: column;
      padding: 1rem 1.5rem;
      gap: 1.2rem;
      width: 100%;
      margin-left: 0;
    }

    .subsystem-card {
      flex: none;
      width: 100%;
      min-width: 0;
      height: auto;
    }

    .subsystem-body {
      flex-direction: column;
    }

    .subsystem-image {
      flex: none;
      height: 200px;
    }

    .subsystem-text {
      font-size: 0.8rem;
      padding: 1rem;
      max-height: 250px;
      overflow-y: auto;
    }
  }
</style>
