---
interface Props {
  id: string;
  title: string;
  technique: string;
  bg: string;
  titleColor: string;
  techColor: string;
  large: boolean;
  thumbs: string[];
}

const { id, title, technique, bg, titleColor, techColor, large, thumbs } = Astro.props;
---

<section class="art-section" data-section-art={id} style={`background: ${bg};`}>
  <div class="art-section-inner">
    <h2 class="art-section-title" style={`color: ${titleColor};`}>{title}</h2>
    <p class="art-section-technique" style={`color: ${techColor};`}>{technique}</p>
    <div class={`art-grid ${large ? 'art-grid-large' : ''}`}>
      {thumbs.map((thumb, idx) => (
        <img
          class="art-thumb"
          src={thumb}
          alt={`${title} ${idx + 1}`}
          loading="lazy"
          data-section={id}
          data-index={idx}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .art-section {
    padding: 4rem 0;
    transition: opacity 0.5s ease, max-height 0.5s ease;
  }

  .art-section.hidden {
    opacity: 0;
    max-height: 0;
    padding: 0;
    overflow: hidden;
  }

  .art-section.visible {
    opacity: 1;
  }

  .art-section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .art-section-title {
    font-family: var(--sans);
    font-size: var(--size-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 0.3rem;
  }

  .art-section-technique {
    font-family: var(--sans);
    font-size: var(--size-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0 0 2rem;
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 6px;
  }

  .art-grid-large {
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .art-thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .art-thumb:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 768px) {
    .art-grid { grid-template-columns: repeat(2, 1fr); }
    .art-grid-large { grid-template-columns: repeat(3, 1fr); }
    .art-section-inner { padding: 0 1rem; }
  }
</style>
