---
/**
 * CharacterStrip — galeria horizontal animada de CharacterCards
 * Fica sobreposta no banner, ocupando 50% (lado direito ou esquerdo).
 * Os cards rolam automaticamente em loop infinito.
 */
import CharacterCard from '../CharacterCard/CharacterCard.astro';

interface Character {
  name: string;
  image: string;
}

interface Props {
  characters: Character[];
  gradient?: string;
  side?: 'left' | 'right';
  speed?: number;
}

const { characters, gradient = 'var(--gradient-bichittos)', side = 'right', speed } = Astro.props;
const autoSpeed = speed ?? characters.length * 5;
const allCards = [...characters, ...characters];
const uid = `strip-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`char-strip char-strip-${side}`}>
  <div class="char-strip-track" data-strip-track={uid} data-speed={autoSpeed}>
    {allCards.map((c) => (
      <CharacterCard name={c.name} image={c.image} gradient={gradient} />
    ))}
  </div>
</div>

<style>
  .char-strip {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    width: 100%;
    height: auto;
    z-index: 2;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .char-strip-track {
    display: flex;
    gap: 1rem;
    padding: 2rem 0;
    width: max-content;
  }

  .char-strip:hover .char-strip-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .char-strip {
      width: 100%;
      position: relative;
      top: auto;
      transform: none;
      margin-top: 2rem;
      mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip-track]').forEach(track => {
    const speed = Number(track.dataset.speed) || 20;
    const halfWidth = track.scrollWidth / 2;

    const keyframes = [
      { transform: 'translateX(0)' },
      { transform: `translateX(-${halfWidth}px)` },
    ];

    track.animate(keyframes, {
      duration: speed * 1000,
      iterations: Infinity,
      easing: 'linear',
    });

    track.closest('.char-strip')?.addEventListener('mouseenter', () => {
      track.getAnimations().forEach(a => a.pause());
    });
    track.closest('.char-strip')?.addEventListener('mouseleave', () => {
      track.getAnimations().forEach(a => a.play());
    });
  });
</script>
