---
/**
 * CharacterStrip — galeria horizontal animada de CharacterCards
 * Fica sobreposta no banner, ocupando 50% (lado direito ou esquerdo).
 * Os cards rolam automaticamente em loop infinito.
 */
import CharacterCard from '../CharacterCard/CharacterCard.astro';

interface Character {
  name: string;
  image: string;
}

interface Props {
  characters: Character[];
  gradient?: string;
  side?: 'left' | 'right';
  speed?: number;
}

const { characters, gradient = 'var(--gradient-bichittos)', side = 'right', speed = 20 } = Astro.props;
// Duplicar os cards para criar loop seamless
const allCards = [...characters, ...characters];
---

<div class={`char-strip char-strip-${side}`}>
  <div class="char-strip-track" style={`--strip-speed: ${speed}s; --strip-items: ${characters.length};`}>
    {allCards.map((c) => (
      <CharacterCard name={c.name} image={c.image} gradient={gradient} />
    ))}
  </div>
</div>

<style>
  .char-strip {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50%;
    height: auto;
    z-index: 2;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .char-strip-right { right: 0; }
  .char-strip-left { left: 0; }

  .char-strip-track {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    width: max-content;
    animation: stripScroll var(--strip-speed) linear infinite;
  }

  .char-strip:hover .char-strip-track {
    animation-play-state: paused;
  }

  @keyframes stripScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 0.5rem)); }
  }

  @media (max-width: 768px) {
    .char-strip {
      width: 100%;
      position: relative;
      top: auto;
      transform: none;
      margin-top: -3rem;
      mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    }
  }
</style>
