---
/**
 * CharacterStrip — galeria horizontal de CharacterCards
 * Fica sobreposta no banner, ocupando 50% (lado direito ou esquerdo).
 * Os cards "emergem" do banner com overflow hidden nas pontas.
 *
 * Props:
 *   characters: array de { name, image }
 *   gradient: CSS gradient para o glow dos cards
 *   side: 'left' | 'right' — qual lado do banner a strip ocupa
 */
import CharacterCard from '../CharacterCard/CharacterCard.astro';

interface Character {
  name: string;
  image: string;
}

interface Props {
  characters: Character[];
  gradient?: string;
  side?: 'left' | 'right';
}

const { characters, gradient = 'var(--gradient-bichittos)', side = 'right' } = Astro.props;
---

<div class={`char-strip char-strip-${side}`}>
  <div class="char-strip-track">
    {characters.map((c) => (
      <CharacterCard name={c.name} image={c.image} gradient={gradient} />
    ))}
  </div>
</div>

<style>
  .char-strip {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50%;
    height: auto;
    z-index: 2;
    overflow: hidden;
    /* Mascara de fade nas pontas */
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .char-strip-right {
    right: 0;
  }

  .char-strip-left {
    left: 0;
  }

  .char-strip-track {
    display: flex;
    gap: 1rem;
    padding: 1rem 2rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
  }

  .char-strip-track::-webkit-scrollbar {
    display: none;
  }

  .char-strip-track > :global(.char-card) {
    scroll-snap-align: center;
  }

  @media (max-width: 768px) {
    .char-strip {
      width: 100%;
      position: relative;
      top: auto;
      transform: none;
      margin-top: -3rem;
      mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    }

    .char-strip-track {
      padding: 1rem;
    }
  }
</style>
