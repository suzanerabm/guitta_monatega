---
/**
 * CharacterStrip — galeria horizontal animada de CharacterCards
 * Fica sobreposta no banner, ocupando 50% (lado direito ou esquerdo).
 * Os cards rolam automaticamente em loop infinito.
 */
import CharacterCard from '../CharacterCard/CharacterCard.astro';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Character {
  name: string;
  image: string;
}

interface Props {
  characters: Character[];
  gradient?: string;
  side?: 'left' | 'right';
  speed?: number;
  cardSize?: number;
  noFloat?: boolean;
  transparent?: boolean;
  noBorder?: boolean;
  noLoop?: boolean;
  showArrows?: boolean;
  noHoverScale?: boolean;
  arrowColor?: string;
  sectionTitle?: string;
  cardBg?: string;
}

const { characters, gradient = 'var(--gradient-bichittos)', side = 'right', speed, cardSize, noFloat = false, transparent = false, noBorder = false, noLoop = false, showArrows = false, noHoverScale = false, arrowColor, sectionTitle, cardBg } = Astro.props;
const autoSpeed = speed ?? characters.length * 5;
const allCards = noLoop ? characters : [...characters, ...characters];
const uid = `strip-${Math.random().toString(36).slice(2, 8)}`;
---

{sectionTitle && (
  <h2 class="strip-section-title" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>{sectionTitle}</h2>
)}
<div class={`char-strip-wrap ${showArrows ? 'has-arrows' : ''}`}>
  {showArrows && (
    <button class="strip-arrow strip-arrow-left" data-strip-arrow="left" aria-label="Previous" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronLeft size={40} />
    </button>
  )}
  <div class={`char-strip char-strip-${side} ${noLoop ? 'char-strip-static' : ''}`}>
    <div class="char-strip-track" {...(!noLoop ? { 'data-strip-track': uid, 'data-speed': String(autoSpeed) } : {})}>
      {allCards.map((c) => (
        <CharacterCard name={c.name} image={c.image} gradient={gradient} cardSize={cardSize} noFloat={noFloat} transparent={transparent} noBorder={noBorder} noHoverScale={noHoverScale} cardBg={cardBg} />
      ))}
    </div>
  </div>
  {showArrows && (
    <button class="strip-arrow strip-arrow-right" data-strip-arrow="right" aria-label="Next" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronRight size={40} />
    </button>
  )}
</div>

<style>
  .char-strip {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    width: 100%;
    height: auto;
    z-index: 2;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }


  .char-strip-static {
    position: relative;
    top: auto;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .char-strip-static::-webkit-scrollbar {
    display: none;
  }

  .char-strip-static .char-strip-track {
    padding: 0.5rem 0 1rem;
  }

  .strip-section-title {
    display: block;
    font-family: var(--sans);
    font-size: var(--size-section);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-weight: 600;
    padding: 0 2rem;
    margin: 5em 2em 0 3em;
  }

  .char-strip-wrap {
    position: relative;
    width: 100%;
  }

  .char-strip-wrap.has-arrows {
    display: flex;
    align-items: center;
  }

  .strip-arrow {
    flex-shrink: 0;
    z-index: 10;
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-overlay-dim);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .strip-arrow:hover {
    opacity: 0.7;
  }

  .strip-arrow-left { margin-right: 0.5rem; }
  .strip-arrow-right { margin-left: 0.5rem; }

  .has-arrows .char-strip {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .has-arrows {
    padding: 0 0.5rem;
  }

  .char-strip-track {
    display: flex;
    gap: 1rem;
    padding: 4rem 0 2rem;
    width: max-content;
  }

  .char-strip:hover .char-strip-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .char-strip {
      width: 100%;
      overflow: hidden;
      position: relative;
      top: auto;
      transform: none;
      margin-top: 2rem;
      mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    }

    .char-strip-static {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .char-strip-static::-webkit-scrollbar {
      display: none;
    }

    .strip-arrow {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip-track]').forEach(track => {
    const speed = Number(track.dataset.speed) || 20;
    const halfWidth = track.scrollWidth / 2;
    const strip = track.closest('.char-strip') as HTMLElement;
    if (!strip) return;

    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    const anim = track.animate(
      [
        { transform: 'translateX(0)' },
        { transform: `translateX(-${halfWidth}px)` },
      ],
      { duration: speed * 1000, iterations: Infinity, easing: 'linear' }
    );

    if (isMobile) {
      // No mobile, animação roda automaticamente; pausa ao tocar
      strip.addEventListener('touchstart', () => anim.pause(), { passive: true });
      strip.addEventListener('touchend', () => anim.play());
      return;
    }

    strip.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = strip.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      // Cantos (< 15% ou > 85%) = acelera, centro = pausa
      if (x < 0.15) {
        anim.playbackRate = -1 - (0.15 - x) * 10;
        anim.play();
      } else if (x > 0.85) {
        anim.playbackRate = 1 + (x - 0.85) * 10;
        anim.play();
      } else {
        anim.pause();
      }
    });

    strip.addEventListener('mouseleave', () => {
      anim.playbackRate = 1;
      anim.play();
    });
  });

  // Arrow navigation
  document.querySelectorAll<HTMLElement>('.has-arrows').forEach(wrap => {
    const strip = wrap.querySelector('.char-strip') as HTMLElement;
    if (!strip) return;
    const track = strip.querySelector('.char-strip-track') as HTMLElement;
    if (!track) return;
    const card = track.querySelector('.char-card') as HTMLElement;
    const scrollAmount = card ? card.offsetWidth + 16 : 300;

    wrap.querySelectorAll<HTMLElement>('[data-strip-arrow]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.stripArrow === 'left' ? -1 : 1;
        strip.scrollBy({ left: dir * scrollAmount, behavior: 'smooth' });
      });
    });
  });
</script>
