---
/**
 * SceneStrip — galeria horizontal de cenas
 * Click abre modal com a imagem grande.
 */
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';

interface Scene {
  name: string;
  image: string;
}

interface Props {
  scenes: Scene[];
  sectionTitle?: string;
  labelColor?: string;
  arrowColor?: string;
}

const { scenes, sectionTitle, labelColor, arrowColor } = Astro.props;
---

<div class="scene-strip-container">
  {sectionTitle && (
    <h2 class="scene-strip-title" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>{sectionTitle}</h2>
  )}
  <div class="scene-strip-row">
    <button class="scene-arrow scene-arrow-left" data-scene-arrow="left" aria-label="Previous" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronLeft size={40} />
    </button>
    <div class="scene-strip-scroll" data-scene-scroll>
      <div class="scene-strip-track">
        {scenes.map((s) => (
          <div class="scene-card" data-scene-src={s.image} data-scene-name={s.name}>
            <div class="scene-card-img-wrap">
              <img src={s.image} alt={s.name} draggable="false" loading="lazy" decoding="async" />
            </div>
            <h4 class="scene-card-name" {...(labelColor ? { style: `color: ${labelColor};` } : {})}>{s.name}</h4>
          </div>
        ))}
      </div>
    </div>
    <button class="scene-arrow scene-arrow-right" data-scene-arrow="right" aria-label="Next" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronRight size={40} />
    </button>
  </div>
</div>

<!-- Scene Modal -->
<div class="scene-modal" data-scene-modal>
  <button class="scene-modal-close" data-scene-modal-close aria-label="Close">
    <X size={32} />
  </button>
  <img class="scene-modal-img" src="" alt="" />
  <span class="scene-modal-name"></span>
</div>

<style>
  .scene-strip-container {
    position: relative;
    padding: 1rem 0;
  }

  .scene-strip-title {
    font-family: var(--sans);
    font-size: var(--size-section);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
    padding: 0 2rem;
    margin-bottom: 0.5rem;
  }

  .scene-strip-row {
    display: flex;
    align-items: center;
  }

  .scene-strip-scroll {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .scene-strip-scroll::-webkit-scrollbar {
    display: none;
  }

  .scene-strip-track {
    display: flex;
    gap: 1.5rem;
    padding: 1rem;
    width: max-content;
  }

  .scene-arrow {
    flex-shrink: 0;
    z-index: 10;
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-overlay-dim);
    cursor: pointer;
    transition: opacity var(--ease-default);
  }

  .scene-arrow:hover {
    opacity: 0.7;
  }

  /* — Scene Card — */
  .scene-card {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .scene-card-img-wrap {
    width: 300px;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .scene-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scene-card:hover .scene-card-img-wrap {
    transform: scale(1.05);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  .scene-card-name {
    font-family: var(--sans);
    font-size: var(--size-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-white);
    font-weight: var(--weight-regular);
    text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    text-align: center;
  }

  /* — Scene Modal — */
  .scene-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .scene-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .scene-modal-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: none;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--ease-default);
  }

  .scene-modal-close:hover {
    opacity: 1;
  }

  .scene-modal-img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }

  .scene-modal-name {
    font-family: var(--sans);
    font-size: var(--size-md);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .scene-arrow {
      display: none;
    }

    .scene-strip-scroll {
      -webkit-overflow-scrolling: touch;
    }

    .scene-card-img-wrap {
      width: 250px;
    }

    .scene-modal-img {
      max-width: 95vw;
      max-height: 70vh;
    }

    .scene-modal-close {
      top: 1rem;
      right: 1rem;
    }
  }
</style>

<script>
  // Arrow navigation
  document.querySelectorAll<HTMLElement>('[data-scene-scroll]').forEach(scroll => {
    const row = scroll.closest('.scene-strip-row');
    if (!row) return;
    const card = scroll.querySelector('.scene-card') as HTMLElement;
    const scrollAmount = card ? card.offsetWidth + 24 : 300;

    row.querySelectorAll<HTMLElement>('[data-scene-arrow]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.sceneArrow === 'left' ? -1 : 1;
        scroll.scrollBy({ left: dir * scrollAmount, behavior: 'smooth' });
      });
    });
  });

  // Click to open modal
  const modal = document.querySelector('[data-scene-modal]') as HTMLElement;
  if (modal) {
    const modalImg = modal.querySelector('.scene-modal-img') as HTMLImageElement;
    const modalName = modal.querySelector('.scene-modal-name') as HTMLElement;

    document.querySelectorAll<HTMLElement>('.scene-card').forEach(card => {
      card.addEventListener('click', () => {
        const src = card.dataset.sceneSrc;
        const name = card.dataset.sceneName;
        if (src && modalImg) {
          modalImg.src = src;
          modalImg.alt = name || '';
        }
        if (name && modalName) modalName.textContent = name;
        modal.classList.add('active');
      });
    });

    // Close on click background or X
    modal.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as HTMLElement).closest('[data-scene-modal-close]')) {
        modal.classList.remove('active');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') modal.classList.remove('active');
    });
  }
</script>
