---
/**
 * SceneStrip — galeria horizontal de cenas
 * Click abre modal com a imagem grande.
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Scene {
  name: string;
  image: string;
}

interface Props {
  scenes: Scene[];
  sectionTitle?: string;
  labelColor?: string;
  arrowColor?: string;
  modalBg?: string;
  modalBgOpacity?: number;
  modalTitle?: string;
  modalSubtitle?: string;
}

const { scenes, sectionTitle, labelColor, arrowColor, modalBg, modalBgOpacity = 0.6, modalTitle, modalSubtitle } = Astro.props;
---

<div class="scene-strip-container" {...(modalBg ? { 'data-modal-bg': modalBg } : {})} data-modal-bg-opacity={String(modalBgOpacity)} {...(modalTitle ? { 'data-modal-title': modalTitle } : {})} {...(modalSubtitle ? { 'data-modal-subtitle': modalSubtitle } : {})}>
  {sectionTitle && (
    <h2 class="scene-strip-title" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>{sectionTitle}</h2>
  )}
  <div class="scene-strip-row">
    <button class="scene-arrow scene-arrow-left" data-scene-arrow="left" aria-label="Previous" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronLeft size={40} />
    </button>
    <div class="scene-strip-scroll" data-scene-scroll>
      <div class="scene-strip-track">
        {scenes.map((s) => (
          <div class="scene-card" data-scene-src={s.image} data-scene-name={s.name}>
            <div class="scene-card-img-wrap">
              <img src={s.image} alt={s.name} draggable="false" loading="lazy" decoding="async" />
            </div>
            <h4 class="scene-card-name" {...(labelColor ? { style: `color: ${labelColor};` } : {})}>{s.name}</h4>
          </div>
        ))}
      </div>
    </div>
    <button class="scene-arrow scene-arrow-right" data-scene-arrow="right" aria-label="Next" {...(arrowColor ? { style: `color: ${arrowColor};` } : {})}>
      <ChevronRight size={40} />
    </button>
  </div>
</div>


<style>
  .scene-strip-container {
    position: relative;
    padding: 1rem 0;
  }

  .scene-strip-title {
    font-family: var(--sans);
    font-size: var(--size-section);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
    padding: 0 2rem;
    margin-top: 5em;
    margin-bottom: 0.5rem;
  }

  .scene-strip-row {
    display: flex;
    align-items: center;
  }

  .scene-strip-scroll {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .scene-strip-scroll::-webkit-scrollbar {
    display: none;
  }

  .scene-strip-track {
    display: flex;
    gap: 1.5rem;
    padding: 1rem;
    width: max-content;
  }

  .scene-arrow {
    flex-shrink: 0;
    z-index: 10;
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-overlay-dim);
    cursor: pointer;
    transition: opacity var(--ease-default);
  }

  .scene-arrow:hover {
    opacity: 0.7;
  }

  /* — Scene Card — */
  .scene-card {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .scene-card-img-wrap {
    width: 300px;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .scene-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scene-card:hover .scene-card-img-wrap {
    transform: scale(1.05);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  .scene-card-name {
    font-family: var(--sans);
    font-size: var(--size-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-white);
    font-weight: var(--weight-bold);
    text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    text-align: center;
  }


  @media (min-width: 1900px) {
    .scene-strip-title {
      font-size: var(--size-h3);
    }

    .scene-card-name {
      font-size: var(--size-md);
    }

    .scene-card-img-wrap {
      width: 500px;
    }
  }

  @media (max-width: 768px) {
    .scene-strip-title {
      margin-top: 2em;
    }

    .scene-arrow {
      display: none;
    }

    .scene-strip-scroll {
      -webkit-overflow-scrolling: touch;
    }

    .scene-card-img-wrap {
      width: 250px;
    }

    .scene-modal-img {
      max-width: 95vw;
      max-height: 70vh;
    }

    .scene-modal-close {
      top: 1rem;
      right: 1rem;
    }
  }
</style>

<script>
  // Arrow navigation
  document.querySelectorAll<HTMLElement>('[data-scene-scroll]').forEach(scroll => {
    const row = scroll.closest('.scene-strip-row');
    if (!row) return;
    const card = scroll.querySelector('.scene-card') as HTMLElement;
    const scrollAmount = card ? card.offsetWidth + 24 : 300;

    row.querySelectorAll<HTMLElement>('[data-scene-arrow]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.sceneArrow === 'left' ? -1 : 1;
        scroll.scrollBy({ left: dir * scrollAmount, behavior: 'smooth' });
      });
    });
  });

  // Click to open scene in modal
  document.querySelectorAll<HTMLElement>('.scene-strip-container').forEach(container => {
    const cards = container.querySelectorAll<HTMLElement>('.scene-card');
    const images = Array.from(cards).map(c => c.dataset.sceneSrc || '');

    cards.forEach((card, i) => {
      card.addEventListener('click', () => {
        if (typeof (window as any).openModal === 'function') {
          const bg = container.dataset.modalBg || 'dark';
          const heroTitle = container.dataset.modalTitle || '';
          const heroText = container.dataset.modalSubtitle || '';
          (window as any).openModal('', '', images, i, bg, heroTitle, heroText);
        }
      });
    });
  });
</script>
