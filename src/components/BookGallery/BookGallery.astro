---
interface BookCover {
  id: string;
  image?: string;
  alt: string;
  label: string;
  soon?: boolean;
}

interface Props {
  title: string;
  books: BookCover[];
}

const { title, books } = Astro.props;
const count = books.length;
---

<div class="book-gallery" data-creature>
  <p class="book-gallery-title">{title}</p>
  <div class={`book-covers book-covers-${count > 4 ? 'many' : count}`}>
    {books.map((book) => (
      <div class={`book-cover ${book.soon ? 'book-cover-soon' : ''}`} data-book={book.soon ? undefined : book.id}>
        {book.soon ? (
          <div class="book-cover-placeholder">
            <span class="book-soon-label">soon</span>
          </div>
        ) : (
          <img src={book.image} alt={book.alt}>
        )}
        <div class="book-cover-label">{book.label}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .book-gallery {
    max-width: 1000px;
    margin: 2rem auto 0;
    padding: 0 3rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .book-gallery.visible { opacity: 1; transform: translateY(0); }

  .book-gallery-title {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1.2rem;
  }

  .book-covers {
    display: grid;
    gap: 1rem;
  }

  .book-covers-1 { grid-template-columns: 1fr; max-width: 280px; }
  .book-covers-2 { grid-template-columns: repeat(2, 1fr); max-width: 560px; }
  .book-covers-3 { grid-template-columns: repeat(3, 1fr); }
  .book-covers-4 { grid-template-columns: repeat(4, 1fr); }
  .book-covers-many { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }

  .book-cover {
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .book-cover:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .book-cover-soon {
    cursor: default;
    opacity: 0.6;
  }

  .book-cover-soon:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
  }

  .book-cover img { width: 100%; height: auto; display: block; }

  .book-cover-placeholder {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-border-soft);
  }

  .book-soon-label {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: var(--weight-regular);
  }

  .book-cover-label {
    padding: 0.6rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-weight: 400;
    background: var(--white);
  }

  @media (max-width: 768px) {
    .book-gallery { padding: 0 1.5rem; }
    .book-covers-3,
    .book-covers-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
