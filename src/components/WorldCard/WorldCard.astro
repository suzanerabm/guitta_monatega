---
interface Props {
  tag: string;
  name: string;
  gradientClass: string;
  showDivider?: boolean;
}

const { tag, name, gradientClass, showDivider = true } = Astro.props;
---

<div class="world" data-world>
  <span class="world-tag">{tag}</span>
  <h2 class="world-name">{name}</h2>
  <div class="world-text">
    <slot />
  </div>
</div>
<div class={`world-banner ${gradientClass}`}>
  <span class="world-banner-label">[ imagem {name} ]</span>
</div>
{showDivider && <div class="world-divider"></div>}

<style>
  .world {
    padding: 5rem 3rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .world.visible { opacity: 1; transform: translateY(0); }

  .world-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.04em;
    margin-bottom: 0.8rem;
  }

  .world-tag {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .world-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
    font-weight: 300;
    max-width: 600px;
  }

  .world-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 50vh;
    min-height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .world-banner-label {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-dark-label);
  }

  .wb-lunnp1 { background: linear-gradient(135deg, #1a3a5c, #2d5f8a, #1a4a6a); }
  .wb-eni4 { background: linear-gradient(135deg, #2a1a3a, #4a2a5a, #3a1a4a); }
  .wb-triplec { background: linear-gradient(135deg, #1a2a1a, #2a4a2a, #1a3a1a); }
  .wb-orfv { background: linear-gradient(135deg, #3a2a1a, #5a4a2a, #4a3a1a); }
  .wb-z1 { background: linear-gradient(135deg, #1a1a2a, #2a2a4a, #1a1a3a); }
  .wb-gotto { background: linear-gradient(135deg, #2a1a1a, #4a2a2a, #3a1a1a); }

  .world-divider {
    width: 40px;
    height: 1px;
    background: var(--color-dark-border);
    margin: 4rem auto;
  }

  @media (max-width: 768px) {
    .world { padding: 3rem 1.5rem 1.5rem; }
    .world-banner { height: 35vh; min-height: 250px; }
  }
</style>
