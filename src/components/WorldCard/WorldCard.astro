---
interface Props {
  tag: string;
  name: string;
  id?: string;
  gradientClass: string;
  showDivider?: boolean;
  stripLayout?: 'banner' | 'side';
}

const { tag, name, id, gradientClass, showDivider = true, stripLayout = 'banner' } = Astro.props;
---

<div class={`world-wrap ${stripLayout === 'side' ? 'world-wrap-side' : ''}`} {...(id ? { [`data-section-world`]: id } : {})}>
  {stripLayout === 'side' ? (
    <div class="world-row">
      <div class="world" data-world>
        <span class="world-tag">{tag}</span>
        <h2 class="world-name">{name}</h2>
        <div class="world-text">
          <slot />
        </div>
      </div>
      <div class="world-strip-side">
        <slot name="strip" />
      </div>
    </div>
  ) : (
    <>
      <div class="world" data-world>
        <span class="world-tag">{tag}</span>
        <h2 class="world-name">{name}</h2>
        <div class="world-text">
          <slot />
        </div>
      </div>
      <div class={`world-banner ${gradientClass}`}>
        <slot name="strip" />
      </div>
    </>
  )}
  <div class={`world-banner-bg ${gradientClass}`}></div>
  {showDivider && <div class="world-divider"></div>}
</div>

<style>
  .world-wrap {
    transition: opacity 0.4s ease, max-height 0.5s ease;
  }

  .world-wrap.hidden {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    padding: 0;
  }

  .world {
    padding: 5rem 3rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .world.visible { opacity: 1; transform: translateY(0); }

  .world-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.04em;
    margin-bottom: 0.8rem;
  }

  .world-tag {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .world-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
    font-weight: 300;
    max-width: 600px;
  }

  .world-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 50vh;
    min-height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .world-banner-label {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-dark-label);
  }

  /* — Side layout: texto esquerda, strip direita — */
  .world-row {
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    gap: 2rem;
  }

  .world-wrap-side .world {
    flex: 1;
    min-width: 0;
  }

  .world-strip-side {
    flex: 0 0 50%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .world-strip-side :global(.char-strip) {
    position: relative;
    top: auto;
    width: 100%;
  }

  .world-banner-bg {
    display: none;
  }

  .world-wrap-side .world-banner-bg {
    display: block;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 200px;
    margin-top: 2rem;
  }

  .wb-lunnp1 { background: linear-gradient(135deg, #004d25, #00c853, #00e676); }
  .wb-eni4 { background: linear-gradient(135deg, #8a5a0a, #e8a317, #f5c842); }
  .wb-triplec { background: linear-gradient(135deg, #00e86a 0%, #00e86a 35%, #7b4fbf 70%, #2a5caa 100%); }
  .wb-orfv { background: linear-gradient(135deg, #d4829a 0%, #d4829a 70%, #40d0e8 100%); }
  .wb-z1 { background: linear-gradient(135deg, #6a7080, #b0b8c4, #d8dce4); }
  .wb-gotto { background: linear-gradient(135deg, #2a1a1a, #4a2a2a, #3a1a1a); }

  .world-divider {
    width: 40px;
    height: 1px;
    background: var(--color-dark-border);
    margin: 4rem auto;
  }

  @media (max-width: 768px) {
    .world { padding: 3rem 1.5rem 1.5rem; }
    .world-banner { height: 35vh; min-height: 250px; }

    .world-row {
      flex-direction: column;
    }

    .world-strip-side {
      flex: none;
      width: 100%;
    }
  }
</style>
