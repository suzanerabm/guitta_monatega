---
interface Props {
  label?: string;
  color?: string;
}

const { label = 'soon', color = 'rgba(255,255,255,0.25)' } = Astro.props;
---

<div class="soon-panel">
  <span class="soon-panel-label" style={`color: ${color}; border-color: ${color};`}>{label}</span>
</div>

<style>
  .soon-panel {
    width: 100%;
    height: 100%;
    min-height: 200px;
    border-radius: 16px;
    outline: 2px solid var(--color-outline-soft);
    outline-offset: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .soon-panel-label {
    font-family: var(--sans);
    font-size: var(--size-soon);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 100;
    padding: 1rem 3rem;
    border: 1px solid;
    border-radius: 40px;
  }
</style>
