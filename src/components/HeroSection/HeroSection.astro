---
interface Props {
  label: string;
  title: string;
  description?: string;
  background: string;
  textColor?: string;
  labelColor?: string;
  minHeight?: string;
}

const {
  label,
  title,
  description,
  background,
  textColor = '#fff',
  labelColor = 'rgba(255,255,255,0.6)',
  minHeight = '25vh',
} = Astro.props;
---

<section class="hero" style={`background: ${background}; min-height: ${minHeight};`}>
  <slot name="decorations" />
  <span class="hero-label" style={`color: ${labelColor};`}>{label}</span>
  <h1 class="hero-title" style={`color: ${textColor};`}>{title}</h1>
  {description && <p class="hero-desc" style={`color: ${textColor}; opacity: 0.75;`}>{description}</p>}
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 8rem 2rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 400;
    z-index: 1;
    opacity: 0;
    animation: fadeIn 0.8s ease 0.1s forwards;
  }

  .hero-title {
    font-family: var(--sans);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    z-index: 1;
    opacity: 0;
    animation: fadeIn 1s ease 0.2s forwards;
  }

  .hero-desc {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    text-align: center;
    max-width: 450px;
    z-index: 1;
    opacity: 0;
    animation: fadeIn 1s ease 0.4s forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
