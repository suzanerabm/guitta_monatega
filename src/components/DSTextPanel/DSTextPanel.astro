---
/**
 * DSTextPanel — Painel de texto com scroll transparente
 *
 * Card com outline flutuante, scroll vertical com fade top/bottom,
 * scrollbar escondida. Reutilizavel em qualquer contexto.
 *
 * Props:
 *   titleColor: cor dos h3
 *   textColor: cor dos p
 */

interface Props {
  titleColor?: string;
  textColor?: string;
}

const {
  titleColor = 'var(--color-text-overlay-bright)',
  textColor = 'var(--color-text-overlay)',
} = Astro.props;
---

<div class="ds-text-panel">
  <div class="ds-text-scroll" style={`--ds-title-color: ${titleColor}; --ds-text-color: ${textColor};`}>
    <slot />
  </div>
</div>

<style>
  .ds-text-panel {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: transparent;
    outline: 2px solid var(--color-outline-mid);
    outline-offset: 3px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  }

  .ds-text-scroll {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2rem 1.5rem;
    font-family: var(--sans);
    font-size: var(--size-md);
    line-height: 1.7;
    font-weight: var(--weight-light);
    mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .ds-text-scroll::-webkit-scrollbar {
    display: none;
  }

  .ds-text-scroll :global(h2) {
    font-size: var(--size-h3);
    font-weight: var(--weight-bold);
    margin-bottom: 0.8rem;
    color: var(--ds-title-color);
  }

  .ds-text-scroll :global(h3) {
    font-size: var(--size-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    margin-top: 1.2rem;
    margin-bottom: 0.3rem;
    color: var(--ds-title-color);
    opacity: 0.8;
  }

  .ds-text-scroll :global(p) {
    margin-bottom: 0.8rem;
    color: var(--ds-text-color);
  }

  @media (max-width: 768px) {
    .ds-text-panel {
      height: auto;
    }
    .ds-text-scroll {
      height: auto;
      overflow: visible;
      padding: 1.5rem 2rem;
      font-size: 0.8rem;
      line-height: 1.5;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .ds-text-scroll :global(h2) {
      font-size: var(--size-md);
      margin-bottom: 0.5rem;
    }
    .ds-text-scroll :global(h3) {
      font-size: var(--size-xs);
      margin-bottom: 0.3rem;
    }
    .ds-text-scroll :global(p) {
      margin-bottom: 0.5rem;
    }
  }
</style>
