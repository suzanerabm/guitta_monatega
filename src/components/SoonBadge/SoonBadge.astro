---
import { Sparkles } from '@lucide/astro';

interface Props {
  label?: string;
  overlay?: boolean;
}

const { label = 'soon', overlay = false } = Astro.props;
---

<span class={`soon-badge ${overlay ? 'soon-badge-overlay' : ''}`}>
  <Sparkles size={12} stroke-width={1.5} />
  <span>{label}</span>
</span>

<style>
  .soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--sans);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: var(--weight-regular);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--white);
  }

  .soon-badge-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 0;
    padding: 0;
    background: rgba(0,0,0,0.35);
    color: var(--color-white);
    font-size: 0.7rem;
  }

  @media (max-width: 768px) {
    .soon-badge {
      font-size: 0.58rem;
      padding: 0.25rem 0.55rem;
    }
    .soon-badge-overlay {
      font-size: 0.6rem;
    }
  }
</style>
