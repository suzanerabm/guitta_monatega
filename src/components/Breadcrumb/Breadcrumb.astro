---
import { getLocalizedPath } from '../../i18n/translations';
import { House, ChevronRight, ArrowLeft } from '@lucide/astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  locale?: string;
}

const { items, locale = 'pt-BR' } = Astro.props;
const homePath = getLocalizedPath('/', locale as any);
---

<nav class="breadcrumb" aria-label="breadcrumb">
  <div class="breadcrumb-trail">
    <a href={homePath} class="breadcrumb-link breadcrumb-home">
      <House size={14} stroke-width={1.5} />
      <span>home</span>
    </a>
    {items.map((item) => (
      <>
        <ChevronRight size={12} stroke-width={1.5} class="breadcrumb-sep" />
        {item.href
          ? <a href={item.href} class="breadcrumb-link">{item.label}</a>
          : <span class="breadcrumb-current">{item.label}</span>
        }
      </>
    ))}
  </div>
  <a href={homePath} class="breadcrumb-back" title={locale === 'en' ? 'back' : 'voltar'}>
    <ArrowLeft size={14} stroke-width={1.5} />
    <span>{locale === 'en' ? 'back' : 'voltar'}</span>
  </a>
</nav>

<style>
  .breadcrumb {
    position: fixed;
    top: 62px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    left: 0;
    right: 0;
    z-index: 99;
    padding: 0.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    background: var(--overlay-light);
    backdrop-filter: blur(14px);
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .breadcrumb-back {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--ease-default);
  }

  .breadcrumb-back:hover {
    color: var(--ink);
  }

  .breadcrumb-home {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumb-link {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--ease-default);
  }

  .breadcrumb-link:hover {
    color: var(--ink);
  }

  .breadcrumb-sep {
    color: var(--ink-muted);
    opacity: 0.35;
  }

  .breadcrumb-current {
    color: var(--ink-soft);
  }

  :global([data-theme="dark"]) .breadcrumb {
    background: var(--color-dark-overlay);
  }

  :global([data-theme="dark"]) .breadcrumb-back,
  :global([data-theme="dark"]) .breadcrumb-link {
    color: var(--color-dark-ink-mid);
  }

  :global([data-theme="dark"]) .breadcrumb-back:hover,
  :global([data-theme="dark"]) .breadcrumb-link:hover {
    color: var(--color-white);
  }

  :global([data-theme="dark"]) .breadcrumb-sep {
    color: var(--color-dark-border-mid);
  }

  :global([data-theme="dark"]) .breadcrumb-current {
    color: var(--color-dark-ink-strong);
  }

  @media (max-width: 768px) {
    .breadcrumb {
      top: 50px;
      padding: 0.4rem 1.5rem;
    }
  }
</style>
