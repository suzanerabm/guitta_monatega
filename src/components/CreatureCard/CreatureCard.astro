---
interface Props {
  name: string;
  bannerImage?: string;
  color1?: string;
  color2?: string;
}

const {
  name,
  bannerImage,
  color1,
  color2,
} = Astro.props;

const hasBannerSlot = Astro.slots.has('banner');
---

<div class="creature" data-creature>
  <h2 class="creature-name" style={color1 ? `color: ${color1};` : ''}>{name}</h2>
  <div class="creature-text" style={color2 ? `color: ${color2};` : ''}>
    <slot />
  </div>
</div>
{hasBannerSlot ? (
  <slot name="banner" />
) : bannerImage ? (
  <div class="creature-banner" style={`background: url('${bannerImage}') center/cover no-repeat;`}>
    <slot name="strip" />
  </div>
) : null}

<style>
  .creature {
    padding: 5rem 3rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .creature.visible { opacity: 1; transform: translateY(0); }

  .creature-name {
    font-family: var(--sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .creature-text {
    font-size: 1.05rem;
    line-height: 1.7;
    font-weight: 300;
    max-width: 600px;
  }

  .creature-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 1400px;
    max-height: 80vh;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 768px) {
    .creature { padding: 1.5rem 1.5rem 0.5rem; }
    .creature-banner { height: 35vh; min-height: 250px; }
  }
</style>
