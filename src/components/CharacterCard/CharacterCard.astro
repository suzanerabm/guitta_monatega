---
interface Props {
  name: string;
  image: string;
  gradient?: string;
  cardSize?: number;
  noFloat?: boolean;
  transparent?: boolean;
  noBorder?: boolean;
  noHoverScale?: boolean;
}

const { name, image, gradient = 'var(--gradient-bichittos)', cardSize, noFloat = false, transparent = false, noBorder = false, noHoverScale = false } = Astro.props;
const size = cardSize || 120;
const wrapperWidth = size + 20;
---

<div class={`char-card ${noFloat ? 'no-float' : ''} ${transparent ? 'transparent' : ''} ${noBorder ? 'no-border' : ''} ${noHoverScale ? 'no-hover-scale' : ''}`} style={`--card-size: ${size}px; --card-width: ${wrapperWidth}px;`}>
  <div class="char-card-glow" style={`background: ${gradient};`}></div>
  <div class="char-card-img-wrap">
    <img src={image} alt={name} class="char-card-img" draggable="false" />
  </div>
  <span class="char-card-name">{name}</span>
</div>

<style>
  .char-card {
    flex-shrink: 0;
    width: var(--card-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    animation: cardFloat 3s ease-in-out infinite;
  }

  .char-card:nth-child(2n) { animation-delay: -1s; }
  .char-card:nth-child(3n) { animation-delay: -2s; }

  .char-card.no-float { animation: none; }

  .char-card.transparent .char-card-img-wrap {
    background: transparent;
    box-shadow: none;
    outline: 2px solid rgba(255,255,255,0.2);
    outline-offset: 3px;
  }

  .char-card.transparent .char-card-glow {
    display: none;
  }

  .char-card.no-border .char-card-img-wrap {
    background: transparent;
    box-shadow: none;
    outline: none;
    border-radius: 8px;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .char-card.no-border .char-card-img {
    padding: 0;
    object-fit: cover;
  }

  .char-card.no-border .char-card-glow {
    display: none;
  }

  .char-card.no-hover-scale:hover .char-card-img-wrap,
  .char-card.no-hover-scale:active .char-card-img-wrap {
    transform: none;
    margin-bottom: 0;
  }

  @keyframes cardFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .char-card-glow {
    position: absolute;
    top: 5px;
    left: 5px;
    right: 5px;
    bottom: 15px;
    border-radius: 16px;
    filter: blur(20px);
    opacity: 0.6;
    z-index: 0;
  }

  .char-card-img-wrap {
    width: var(--card-size);
    height: var(--card-size);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-white);
    position: relative;
    z-index: 1;
    transition: transform 0.25s ease;
    box-shadow:
      0 12px 40px rgba(0,0,0,0.15),
      0 0 20px rgba(255,255,255,0.15);
    outline: 2px solid rgba(255,255,255,0.35);
    outline-offset: 3px;
  }

  .char-card:hover,
  .char-card:active {
    z-index: 10;
  }

  .char-card:hover .char-card-img-wrap,
  .char-card:active .char-card-img-wrap {
    transform: scale(1.35);
  }

  .char-card.transparent:hover .char-card-img-wrap,
  .char-card.transparent:active .char-card-img-wrap {
    transform: scale(1.8);
    outline: none;
  }

  .char-card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 8px;
  }

  .char-card-name {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white);
    font-weight: var(--weight-regular);
    z-index: 1;
    text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    text-align: center;
    transition: transform 0.25s ease;
  }

  .char-card:hover .char-card-name,
  .char-card:active .char-card-name {
    transform: translateY(2rem);
  }

  @media (max-width: 768px) {
    .char-card { width: calc(var(--card-width) * 0.8); }
    .char-card-img-wrap { width: calc(var(--card-size) * 0.8); height: calc(var(--card-size) * 0.8); border-radius: 12px; }
    .char-card:hover .char-card-img-wrap,
    .char-card:active .char-card-img-wrap {
      transform: scale(1.2);
    }
    .char-card-name { font-size: 0.6rem; }
  }
</style>
