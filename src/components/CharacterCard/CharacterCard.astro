---
interface Props {
  name: string;
  image: string;
  gradient?: string;
}

const { name, image, gradient = 'var(--gradient-bichittos)' } = Astro.props;
---

<div class="char-card">
  <div class="char-card-glow" style={`background: ${gradient};`}></div>
  <div class="char-card-img-wrap">
    <img src={image} alt={name} class="char-card-img" />
  </div>
  <span class="char-card-name">{name}</span>
</div>

<style>
  .char-card {
    flex-shrink: 0;
    width: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    animation: cardFloat 3s ease-in-out infinite;
  }

  .char-card:nth-child(2n) { animation-delay: -1s; }
  .char-card:nth-child(3n) { animation-delay: -2s; }

  @keyframes cardFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .char-card-glow {
    position: absolute;
    top: 5px;
    left: 5px;
    right: 5px;
    bottom: 15px;
    border-radius: 16px;
    filter: blur(20px);
    opacity: 0.6;
    z-index: 0;
  }

  .char-card-img-wrap {
    width: 120px;
    height: 120px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-white);
    position: relative;
    z-index: 1;
    transition: transform 0.25s ease;
    box-shadow:
      0 12px 40px rgba(0,0,0,0.15),
      0 0 20px rgba(255,255,255,0.15);
    outline: 2px solid rgba(255,255,255,0.35);
    outline-offset: 3px;
  }

  .char-card:hover .char-card-img-wrap,
  .char-card:active .char-card-img-wrap {
    transform: scale(1.35);
    margin-bottom: 2rem;
  }

  .char-card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 8px;
  }

  .char-card-name {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white);
    font-weight: var(--weight-regular);
    z-index: 1;
    text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    text-align: center;
  }

  @media (max-width: 768px) {
    .char-card { width: 110px; }
    .char-card-img-wrap { width: 96px; height: 96px; border-radius: 12px; }
    .char-card:hover .char-card-img-wrap,
    .char-card:active .char-card-img-wrap {
      transform: scale(1.2);
      margin-bottom: 0.5rem;
    }
    .char-card-name { font-size: 0.6rem; }
  }
</style>
