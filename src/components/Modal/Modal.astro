---
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';
---
<!--
  Modal/Lightbox reutilizável.
  Uso: openModal(title, technique, images, startIndex, theme)
       registerGallery(name, images) + openGallery(name, index, title, technique, theme)
-->
<div class="modal-overlay" id="modalOverlay">
  <button class="modal-close" id="modalClose"><X size={20} strokeWidth={1.5} /></button>
  <div class="modal-body">
    <div class="modal-hero" id="modalHero" style="display:none;">
      <h2 class="modal-hero-title" id="modalHeroTitle"></h2>
      <p class="modal-hero-text" id="modalHeroText"></p>
    </div>
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle"></h3>
      <p class="modal-technique" id="modalTechnique"></p>
    </div>
    <div class="modal-img-wrap">
      <img class="modal-img" id="modalImg" src="" alt="">
    </div>
  </div>
  <div class="modal-nav">
    <button class="modal-btn" id="modalPrev"><ChevronLeft size={18} strokeWidth={1.5} /></button>
    <span class="modal-counter" id="modalCounter"></span>
    <button class="modal-btn" id="modalNext"><ChevronRight size={18} strokeWidth={1.5} /></button>
  </div>
</div>

<style>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--overlay-light-full);
    z-index: 200;
    flex-direction: column;
  }

  .modal-overlay.open {
    display: flex;
  }

  .modal-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-size: 1.3rem;
    color: var(--color-ink-muted);
    cursor: pointer;
    background: none;
    border: none;
    z-index: 201;
    transition: color 0.2s;
  }

  .modal-close:hover { color: var(--color-ink); }

  .modal-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    justify-content: center;
    padding: 2rem 2rem 5rem;
    gap: 0.8rem;
  }

  .modal-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .modal-title {
    font-family: var(--sans);
    font-size: var(--size-2xl);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .modal-technique {
    font-family: var(--sans);
    font-size: var(--size-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .modal-img-wrap {
    max-width: 75vw;
    max-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border-radius: 4px;
    box-shadow: var(--shadow-md);
    padding: 1rem;
  }

  .modal-img {
    max-width: 100%;
    max-height: 63vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .modal-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1.2rem;
    background: var(--overlay-light-soft);
    backdrop-filter: blur(8px);
  }

  .modal-counter {
    font-family: var(--sans);
    font-size: var(--size-sm);
    color: var(--color-subtle);
    letter-spacing: var(--tracking-wide);
  }

  .modal-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-ink-muted);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.3rem 1rem;
    border-radius: 4px;
    font-family: var(--sans);
    transition: all 0.2s;
  }

  .modal-btn:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  /* Dark theme */
  /* Modal hero block */
  .modal-hero {
    padding: 1.5rem 2rem 1rem;
    max-width: 600px;
  }

  .modal-hero-title {
    font-family: var(--sans);
    font-size: var(--size-h2);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: 0.5rem;
  }

  .modal-hero-text {
    font-family: var(--sans);
    font-size: var(--size-base);
    line-height: 1.5;
    font-weight: var(--weight-light);
  }

  .modal-overlay.dark .modal-hero-title { color: var(--color-white); }
  .modal-overlay.dark .modal-hero-text { color: var(--color-text-overlay); }

  .modal-overlay.dark { background: var(--modal-bg, var(--overlay-dark)); }
  .modal-overlay.dark .modal-close { color: var(--color-dark-ink-mid); }
  .modal-overlay.dark .modal-close:hover { color: var(--color-white); }
  .modal-overlay.dark .modal-title { color: var(--color-white); }
  .modal-overlay.dark .modal-technique { color: var(--color-dark-ink-muted); }
  .modal-overlay.dark .modal-img-wrap { background: rgba(255,255,255,0.05); box-shadow: none; }
  .modal-overlay.dark .modal-nav { background: var(--overlay-dark-soft); }
  .modal-overlay.dark .modal-counter { color: var(--color-dark-ink-muted); }
  .modal-overlay.dark .modal-btn { border-color: var(--color-dark-border-mid); color: var(--color-dark-ink-mid); }
  .modal-overlay.dark .modal-btn:hover { border-color: var(--color-white); color: var(--color-white); }

  @media (max-width: 768px) {
    .modal-body { padding: 4rem 1rem 5rem; }
    .modal-img-wrap { max-width: 92vw; max-height: 55vh; }
    .modal-img { max-height: 53vh; }
  }
</style>

<script>
  let currentImages: string[] = [];
  let currentIndex = 0;
  let currentTitle = '';
  let currentTechnique = '';
  const galleries: Record<string, string[]> = {};

  const overlay = document.getElementById('modalOverlay')!;
  const imgEl = document.getElementById('modalImg') as HTMLImageElement;
  const titleEl = document.getElementById('modalTitle')!;
  const techEl = document.getElementById('modalTechnique')!;
  const counterEl = document.getElementById('modalCounter')!;
  const heroEl = document.getElementById('modalHero')!;
  const heroTitleEl = document.getElementById('modalHeroTitle')!;
  const heroTextEl = document.getElementById('modalHeroText')!;

  function formatFilename(path: string): string {
    const file = path.split('/').pop() || '';
    return file
      .replace(/\.[^.]+$/, '')       // remove extension
      .replace(/[_]/g, ' ')          // underscores to spaces
      .replace(/^\d+\s*/, '')        // remove leading numbers
      .replace(/\s+/g, ' ')          // collapse spaces
      .trim();
  }

  function show() {
    imgEl.src = currentImages[currentIndex];
    titleEl.textContent = currentTitle;
    techEl.textContent = currentTechnique || formatFilename(currentImages[currentIndex]);
    counterEl.textContent = (currentIndex + 1) + ' / ' + currentImages.length;
  }

  (window as any).openModal = function (title: string, technique: string, images: string[], startIndex: number, theme?: string, heroTitle?: string, heroText?: string) {
    currentTitle = title || '';
    currentTechnique = technique || '';
    currentImages = images || [];
    currentIndex = startIndex || 0;
    overlay.classList.remove('dark');
    overlay.style.removeProperty('--modal-bg');
    if (heroTitle || heroText) {
      heroTitleEl.textContent = heroTitle || '';
      heroTextEl.textContent = heroText || '';
      heroEl.style.display = 'block';
    } else {
      heroEl.style.display = 'none';
    }
    if (theme === 'dark') {
      overlay.classList.add('dark');
    } else if (theme && theme !== 'light') {
      overlay.classList.add('dark');
      overlay.style.setProperty('--modal-bg', theme);
    }
    show();
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  (window as any).closeModal = function () {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  };

  (window as any).navModal = function (dir: number) {
    currentIndex += dir;
    if (currentIndex < 0) currentIndex = currentImages.length - 1;
    if (currentIndex >= currentImages.length) currentIndex = 0;
    show();
  };

  (window as any).registerGallery = function (name: string, images: string[]) {
    galleries[name] = images;
  };

  (window as any).openGallery = function (name: string, index: number, title: string, technique: string, theme?: string) {
    if (!galleries[name]) return;
    (window as any).openModal(title, technique, galleries[name], index, theme);
  };

  document.getElementById('modalClose')!.addEventListener('click', (window as any).closeModal);
  document.getElementById('modalPrev')!.addEventListener('click', () => (window as any).navModal(-1));
  document.getElementById('modalNext')!.addEventListener('click', () => (window as any).navModal(1));

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) (window as any).closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('open')) return;
    if (e.key === 'ArrowRight') (window as any).navModal(1);
    if (e.key === 'ArrowLeft') (window as any).navModal(-1);
    if (e.key === 'Escape') (window as any).closeModal();
  });
</script>
