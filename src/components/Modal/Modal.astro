---
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';
---
<!--
  Modal/Lightbox reutilizável.
  Uso: openModal(title, technique, images, startIndex, theme)
       registerGallery(name, images) + openGallery(name, index, title, technique, theme)
-->
<div class="modal-overlay" id="modalOverlay">
  <button class="modal-close" id="modalClose"><X size={20} strokeWidth={1.5} /></button>
  <div class="modal-body">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle"></h3>
      <p class="modal-technique" id="modalTechnique"></p>
    </div>
    <div class="modal-img-wrap">
      <img class="modal-img" id="modalImg" src="" alt="">
    </div>
  </div>
  <div class="modal-nav">
    <button class="modal-btn" id="modalPrev"><ChevronLeft size={18} strokeWidth={1.5} /></button>
    <span class="modal-counter" id="modalCounter"></span>
    <button class="modal-btn" id="modalNext"><ChevronRight size={18} strokeWidth={1.5} /></button>
  </div>
</div>

<style>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,0.97);
    z-index: 200;
    flex-direction: column;
  }

  .modal-overlay.open {
    display: flex;
  }

  .modal-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-size: 1.3rem;
    color: #999;
    cursor: pointer;
    background: none;
    border: none;
    z-index: 201;
    transition: color 0.2s;
  }

  .modal-close:hover { color: #333; }

  .modal-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    justify-content: center;
    padding: 2rem 2rem 5rem;
    gap: 0.8rem;
  }

  .modal-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .modal-title {
    font-family: 'Fira Sans', system-ui, sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1d21;
    margin: 0;
  }

  .modal-technique {
    font-family: 'Fira Sans', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #999;
    margin: 0;
  }

  .modal-img-wrap {
    max-width: 75vw;
    max-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    border-radius: 4px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    padding: 1rem;
  }

  .modal-img {
    max-width: 100%;
    max-height: 63vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .modal-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1.2rem;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
  }

  .modal-counter {
    font-family: 'Fira Sans', system-ui, sans-serif;
    font-size: 0.72rem;
    color: #ccc;
    letter-spacing: 0.1em;
  }

  .modal-btn {
    background: none;
    border: 1px solid #e0e0e0;
    color: #999;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.3rem 1rem;
    border-radius: 4px;
    font-family: 'Fira Sans', system-ui, sans-serif;
    transition: all 0.2s;
  }

  .modal-btn:hover {
    border-color: #333;
    color: #333;
  }

  /* Dark theme */
  .modal-overlay.dark { background: rgba(0,0,0,0.95); }
  .modal-overlay.dark .modal-close { color: rgba(255,255,255,0.5); }
  .modal-overlay.dark .modal-close:hover { color: #fff; }
  .modal-overlay.dark .modal-title { color: #fff; }
  .modal-overlay.dark .modal-technique { color: rgba(255,255,255,0.4); }
  .modal-overlay.dark .modal-img-wrap { background: rgba(255,255,255,0.05); box-shadow: none; }
  .modal-overlay.dark .modal-nav { background: rgba(0,0,0,0.8); }
  .modal-overlay.dark .modal-counter { color: rgba(255,255,255,0.3); }
  .modal-overlay.dark .modal-btn { border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.5); }
  .modal-overlay.dark .modal-btn:hover { border-color: #fff; color: #fff; }

  @media (max-width: 768px) {
    .modal-body { padding: 4rem 1rem 5rem; }
    .modal-img-wrap { max-width: 92vw; max-height: 55vh; }
    .modal-img { max-height: 53vh; }
  }
</style>

<script>
  let currentImages: string[] = [];
  let currentIndex = 0;
  let currentTitle = '';
  let currentTechnique = '';
  const galleries: Record<string, string[]> = {};

  const overlay = document.getElementById('modalOverlay')!;
  const imgEl = document.getElementById('modalImg') as HTMLImageElement;
  const titleEl = document.getElementById('modalTitle')!;
  const techEl = document.getElementById('modalTechnique')!;
  const counterEl = document.getElementById('modalCounter')!;

  function show() {
    imgEl.src = currentImages[currentIndex];
    titleEl.textContent = currentTitle;
    techEl.textContent = currentTechnique;
    counterEl.textContent = (currentIndex + 1) + ' / ' + currentImages.length;
  }

  (window as any).openModal = function (title: string, technique: string, images: string[], startIndex: number, theme?: string) {
    currentTitle = title || '';
    currentTechnique = technique || '';
    currentImages = images || [];
    currentIndex = startIndex || 0;
    if (theme === 'dark') {
      overlay.classList.add('dark');
    } else {
      overlay.classList.remove('dark');
    }
    show();
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  (window as any).closeModal = function () {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  };

  (window as any).navModal = function (dir: number) {
    currentIndex += dir;
    if (currentIndex < 0) currentIndex = currentImages.length - 1;
    if (currentIndex >= currentImages.length) currentIndex = 0;
    show();
  };

  (window as any).registerGallery = function (name: string, images: string[]) {
    galleries[name] = images;
  };

  (window as any).openGallery = function (name: string, index: number, title: string, technique: string, theme?: string) {
    if (!galleries[name]) return;
    (window as any).openModal(title, technique, galleries[name], index, theme);
  };

  document.getElementById('modalClose')!.addEventListener('click', (window as any).closeModal);
  document.getElementById('modalPrev')!.addEventListener('click', () => (window as any).navModal(-1));
  document.getElementById('modalNext')!.addEventListener('click', () => (window as any).navModal(1));

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) (window as any).closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('open')) return;
    if (e.key === 'ArrowRight') (window as any).navModal(1);
    if (e.key === 'ArrowLeft') (window as any).navModal(-1);
    if (e.key === 'Escape') (window as any).closeModal();
  });
</script>
