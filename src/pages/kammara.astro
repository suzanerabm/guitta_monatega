---
import KammaraLayout from '../layouts/KammaraLayout.astro';

const worlds = [
  { tag: 'Planeta', name: "LUNN'P1", css: 'wb-lunnp1' },
  { tag: 'Planeta', name: 'ENI-4\u0394', css: 'wb-eni4' },
  { tag: 'Estacao Espacial', name: 'TripleC', css: 'wb-triplec' },
  { tag: 'Planeta', name: 'ORF-V', css: 'wb-orfv' },
  { tag: 'Planeta', name: 'Z1', css: 'wb-z1' },
  { tag: 'Planeta', name: 'Gotto', css: 'wb-gotto' },
];
---

<KammaraLayout title="Kammara — Guitta Monatega">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-stars">
      <div class="hero-star"></div><div class="hero-star"></div><div class="hero-star"></div>
      <div class="hero-star"></div><div class="hero-star"></div><div class="hero-star"></div>
    </div>
    <div class="hero-glow"></div>
    <span class="hero-label">Saga Ilustrada</span>
    <h1 class="hero-title">Kammara</h1>
    <p class="hero-desc">Mundos conectados. Sistemas vivos. Uma saga que cresce a cada capitulo.</p>
  </section>

  {worlds.map((world, i) => (
    <>
      <div class="world" data-world>
        <span class="world-tag">{world.tag}</span>
        <h2 class="world-name">{world.name}</h2>
        <div class="world-text">
          <p>Placeholder — descricao vai aqui.</p>
        </div>
      </div>
      <div class={`world-banner ${world.css}`}>
        <span class="world-banner-label">[ imagem {world.name} ]</span>
      </div>
      {i < worlds.length - 1 && <div class="world-divider" style="margin: 4rem auto;"></div>}
    </>
  ))}

</KammaraLayout>

<style>
  .hero {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 8rem 2rem 4rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0a0a2e, #1a1a4e, #2d1b69, #0f3460, #0a0a2e);
    background-size: 400% 400%;
    animation: fluidCosmos 20s ease-in-out infinite;
  }

  .hero-stars {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    animation: twinkle 4s ease-in-out infinite;
  }

  .hero-star:nth-child(1) { width: 2px; height: 2px; top: 10%; left: 15%; }
  .hero-star:nth-child(2) { width: 3px; height: 3px; top: 20%; left: 70%; animation-delay: 1s; }
  .hero-star:nth-child(3) { width: 1.5px; height: 1.5px; top: 35%; left: 40%; animation-delay: 2s; }
  .hero-star:nth-child(4) { width: 2px; height: 2px; top: 50%; left: 85%; animation-delay: 0.5s; }
  .hero-star:nth-child(5) { width: 2.5px; height: 2.5px; top: 65%; left: 25%; animation-delay: 3s; }
  .hero-star:nth-child(6) { width: 2px; height: 2px; top: 80%; left: 60%; animation-delay: 1.5s; }

  .hero-glow {
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100,80,200,0.15) 0%, transparent 70%);
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    animation: glowPulse 8s ease-in-out infinite;
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-muted);
    z-index: 1;
    opacity: 0;
    animation: fadeIn 0.8s ease 0.1s forwards;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 40px rgba(100,80,200,0.4);
    z-index: 1;
    opacity: 0;
    animation: fadeIn 1s ease 0.2s forwards;
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--ink-soft);
    font-weight: 300;
    line-height: 1.5;
    text-align: center;
    max-width: 450px;
    z-index: 1;
    opacity: 0;
    animation: fadeIn 1s ease 0.4s forwards;
  }

  .world {
    padding: 5rem 3rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .world.visible { opacity: 1; transform: translateY(0); }

  .world-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    margin-bottom: 0.8rem;
  }

  .world-tag {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .world-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
    font-weight: 300;
    max-width: 600px;
  }

  .world-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 50vh;
    min-height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .world-banner-label {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
  }

  .wb-lunnp1 { background: linear-gradient(135deg, #1a3a5c, #2d5f8a, #1a4a6a); }
  .wb-eni4 { background: linear-gradient(135deg, #2a1a3a, #4a2a5a, #3a1a4a); }
  .wb-triplec { background: linear-gradient(135deg, #1a2a1a, #2a4a2a, #1a3a1a); }
  .wb-orfv { background: linear-gradient(135deg, #3a2a1a, #5a4a2a, #4a3a1a); }
  .wb-z1 { background: linear-gradient(135deg, #1a1a2a, #2a2a4a, #1a1a3a); }
  .wb-gotto { background: linear-gradient(135deg, #2a1a1a, #4a2a2a, #3a1a1a); }

  .world-divider {
    width: 40px;
    height: 1px;
    background: rgba(255,255,255,0.08);
    margin: 0 auto;
  }

  @keyframes fluidCosmos {
    0% { background-position: 0% 50%; }
    25% { background-position: 75% 0%; }
    50% { background-position: 100% 50%; }
    75% { background-position: 25% 100%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  @keyframes glowPulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.5; }
    50% { transform: translateX(-50%) scale(1.3); opacity: 0.8; }
  }

  @media (max-width: 768px) {
    .world { padding: 3rem 1.5rem 1.5rem; }
    .world-banner { height: 35vh; min-height: 250px; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('[data-world]').forEach(el => observer.observe(el));
</script>
