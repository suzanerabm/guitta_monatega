---
import BaseLayout from '../layouts/BaseLayout.astro';
import Modal from '../components/Modal.astro';
---

<BaseLayout title="Bichittos — Guitta Monatega">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-shapes">
      <div class="hero-shape"></div>
      <div class="hero-shape"></div>
      <div class="hero-shape"></div>
    </div>
    <span class="hero-label">Serie</span>
    <h1 class="hero-title">Bichittos</h1>
    <p class="hero-desc">Criaturas que existem entre o absurdo e o afeto.</p>
  </section>

  <!-- NAPCAT -->
  <div class="creature" data-creature>
    <h2 class="creature-name">NapCat</h2>
    <div class="creature-text">
      <p>Cinza, macio, com a ponta do rabo azul — como se tivesse mergulhado num balde de tinta. Calmo, charmoso, sempre de bom humor. O que ele mais gosta e tirar soneca. Tem uma irma gemea, a Violeta.</p>
    </div>
  </div>
  <div class="creature-banner" style="background: url('/imgs/banners/banner_napcat.jpg') center/cover no-repeat;"></div>

  <div class="creature-divider" style="margin: 4rem auto;"></div>

  <!-- ZECO -->
  <div class="creature" data-creature>
    <h2 class="creature-name">Zeco</h2>
    <div class="creature-text">
      <p>Redondo, laranja, com meias xadrez. Faz amizade com qualquer um. Adora picole, tem medo de geladeira e chora por qualquer coisa — mas no minuto seguinte ja esta rindo de novo.</p>
    </div>
  </div>
  <div class="creature-banner" style="background: url('/imgs/banners/banner_zeco.jpg') center/cover no-repeat;"></div>

  <!-- ZECO BOOKS -->
  <div class="book-gallery" data-creature>
    <p class="book-gallery-title">Livros · As 4 Estacoes</p>
    <div class="book-covers">
      <div class="book-cover" data-book="primavera">
        <img src="/imgs/banners/cover_primavera.jpg" alt="Zeco na Primavera">
        <div class="book-cover-label">Primavera</div>
      </div>
      <div class="book-cover" data-book="verao">
        <img src="/imgs/banners/cover_verao.jpg" alt="Zeco no Verao">
        <div class="book-cover-label">Verao</div>
      </div>
      <div class="book-cover" data-book="outono">
        <img src="/imgs/banners/cover_outono.jpg" alt="Zeco no Outono">
        <div class="book-cover-label">Outono</div>
      </div>
      <div class="book-cover" data-book="inverno">
        <img src="/imgs/banners/cover_inverno.jpg" alt="Zeco no Inverno">
        <div class="book-cover-label">Inverno</div>
      </div>
    </div>
  </div>

  <div class="creature-divider" style="margin: 4rem auto;"></div>

  <!-- TAYLO -->
  <div class="creature" data-creature>
    <h2 class="creature-name">Taylo</h2>
    <div class="creature-text">
      <p>Um urso com orelhas maiores que os outros — e isso o torna especial. Adora contar historias. Herdou dos ancestrais o poder das estrelas: uma vez por ano, no penhasco magico, ele caca as que caem do ceu.</p>
      <p>Na floresta, todo mundo e amigo dele — Pitu, Squizo, Candy e os outros. Juntos, formam o universo Taylo.</p>
    </div>
  </div>
  <div class="creature-banner" style="background: url('/imgs/banners/banner_taylo.jpg') center/cover no-repeat;"></div>

  <Modal />

</BaseLayout>

<style>
  .hero {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 8rem 2rem 4rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #ff6b9d 0%, #ffa751 30%, #ffe259 60%, #6dd5fa 100%);
  }

  .hero-shapes {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.12;
    background: #fff;
    animation: shapeFloat 6s ease-in-out infinite;
  }

  .hero-shape:nth-child(1) { width: 150px; height: 150px; top: 10%; left: 5%; }
  .hero-shape:nth-child(2) { width: 80px; height: 80px; top: 60%; right: 10%; animation-delay: 2s; border-radius: 30%; }
  .hero-shape:nth-child(3) { width: 100px; height: 100px; bottom: 15%; left: 20%; animation-delay: 1s; }

  .hero-label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    font-weight: 400;
    opacity: 0;
    animation: fadeIn 0.8s ease 0.1s forwards;
  }

  .hero-title {
    font-family: var(--sans);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 30px rgba(0,0,0,0.15);
    opacity: 0;
    animation: fadeIn 1s ease 0.2s forwards;
  }

  .hero-desc {
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
    font-weight: 300;
    line-height: 1.5;
    text-align: center;
    max-width: 400px;
    opacity: 0;
    animation: fadeIn 1s ease 0.4s forwards;
  }

  .creature {
    padding: 5rem 3rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .creature.visible { opacity: 1; transform: translateY(0); }

  .creature-name {
    font-family: var(--sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .creature-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
    font-weight: 300;
    max-width: 600px;
  }

  .creature-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 50vh;
    min-height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .creature-divider {
    width: 40px;
    height: 1px;
    background: #e0e0e0;
    margin: 0 auto;
  }

  .book-gallery {
    max-width: 1000px;
    margin: 2rem auto 0;
    padding: 0 3rem;
  }

  .book-gallery-title {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1.2rem;
  }

  .book-covers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .book-cover {
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .book-cover:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }

  .book-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .book-cover-label {
    padding: 0.6rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-weight: 400;
    background: var(--white);
  }

  @keyframes shapeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }

  @media (max-width: 768px) {
    .creature { padding: 3rem 1.5rem 1.5rem; }
    .creature-banner { height: 35vh; min-height: 250px; }
  }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('[data-creature]').forEach(el => observer.observe(el));

  // Book data
  const books: Record<string, { title: string; pages: string[] }> = {
    primavera: {
      title: 'Zeco na Primavera',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/primavera/_png/primaveracena_${i}_${['capa','intro','acordar','limpeza','flores','abelha','alvoroco','gralhaazul','colher','cozinhar','compota','piquenique','ipe','pordosol','capa_fim'][i]}.png`)
    },
    verao: {
      title: 'Zeco no Verao',
      pages: Array.from({ length: 16 }, (_, i) => `/imgs/Zeco/Books/verao/_png/veraocena_${i}_${['capa','intro','nadando','rio','secando','praia','refrescando','pescando','chovendo','picole','carnaval','soneca','brincar','chule','limpar','fim'][i]}.png`)
    },
    outono: {
      title: 'Zeco no Outono',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/outono/_png/outonocena_${i}_${['capa','intro','cedinho','armario','lavar','bolinho','cha','passear','tv','varrer','gafanhoto','jantar','lareira','chocolate','capa_fim'][i]}.png`)
    },
    inverno: {
      title: 'Zeco no Inverno',
      pages: Array.from({ length: 15 }, (_, i) => `/imgs/Zeco/Books/inverno/_png/invernocena_${i}_${['capa','intro','acordar','embacada','brincar','pintura','festa','licao','cola','jogando','baralho','gibi','jantar','nanar','capa_fim'][i]}.png`)
    }
  };

  // Register galleries
  Object.keys(books).forEach(k => (window as any).registerGallery('book_' + k, books[k].pages));

  // Book click handlers
  document.querySelectorAll<HTMLElement>('[data-book]').forEach(el => {
    el.addEventListener('click', () => {
      const season = el.dataset.book!;
      const book = books[season];
      (window as any).openGallery('book_' + season, 0, book.title, 'Livro ilustrado');
    });
  });
</script>
