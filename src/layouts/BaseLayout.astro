---
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import Breadcrumb from '../components/Breadcrumb/Breadcrumb.astro';
import { getLocalizedPath, useTranslations } from '../i18n/translations';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  transparentHeader?: boolean;
  breadcrumb?: BreadcrumbItem[];
  theme?: 'light' | 'dark';
  locale?: string;
}

const { title, transparentHeader = false, breadcrumb, theme = 'light', locale = 'pt-BR' } = Astro.props;
const htmlLang = locale === 'en' ? 'en' : 'pt-BR';
const homePath = getLocalizedPath('/', locale as any);
const aboutPath = getLocalizedPath('/about', locale as any);
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const t = useTranslations(locale);
---

<!DOCTYPE html>
<html lang={htmlLang} data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
</head>
<body>
  <Header homePath={homePath} transparent={transparentHeader} locale={locale} currentPath={currentPath} />

  {breadcrumb && <Breadcrumb items={breadcrumb} locale={locale} />}

  <slot />

  <Footer aboutPath={aboutPath} aboutLabel={t.common.footerAbout} />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  const header = document.querySelector('header');
  const breadcrumb = document.querySelector('.breadcrumb');
  const filterBar = document.querySelector('.filter-bar');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const scrollingDown = y > lastScroll && y > 80;

    if (scrollingDown) {
      header?.classList.add('compact');
      if (breadcrumb) {
        (breadcrumb as HTMLElement).style.transform = 'translateY(-100%)';
        (breadcrumb as HTMLElement).style.opacity = '0';
      }
      if (filterBar) {
        (filterBar as HTMLElement).style.top = '42px';
      }
    } else {
      header?.classList.remove('compact');
      if (breadcrumb) {
        (breadcrumb as HTMLElement).style.transform = 'translateY(0)';
        (breadcrumb as HTMLElement).style.opacity = '1';
      }
      if (filterBar) {
        (filterBar as HTMLElement).style.top = '92px';
      }
    }
    lastScroll = y;
  }, { passive: true });
</script>
