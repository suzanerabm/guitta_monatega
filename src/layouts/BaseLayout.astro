---
import LanguageToggle from '../components/LanguageToggle/LanguageToggle.astro';
import Breadcrumb from '../components/Breadcrumb/Breadcrumb.astro';
import { getLocalizedPath } from '../i18n/translations';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  transparentHeader?: boolean;
  breadcrumb?: BreadcrumbItem[];
  theme?: 'light' | 'dark';
  locale?: string;
}

const { title, transparentHeader = false, breadcrumb, theme = 'light', locale = 'pt-BR' } = Astro.props;
const htmlLang = locale === 'en' ? 'en' : 'pt-BR';
const homePath = getLocalizedPath('/', locale as any);
const aboutPath = getLocalizedPath('/about', locale as any);
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
---

<!DOCTYPE html>
<html lang={htmlLang} data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
</head>
<body>
  <header class={transparentHeader ? 'transparent' : ''}>
    <a href={homePath} class="header-name"><strong>guitta</strong> monatega</a>
    <div class="header-right">
      <LanguageToggle locale={locale} currentPath={currentPath} />
    </div>
  </header>

  {breadcrumb && <Breadcrumb items={breadcrumb} locale={locale} />}

  <slot />

  <footer>
    <div class="footer-line"></div>
    <a href={aboutPath} class="footer-name">guitta monatega</a>
    <span class="footer-brand">mosaicQ</span>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
