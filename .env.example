# Copie para `.env.local` e ajuste. Nenhuma dessas variáveis é obrigatória —
# todas têm fallback no código.

# ─── Base das mídias (imagens e vídeos) ──────────────────────────────────────
#
# VAZIO / AUSENTE (default) = modo LOCAL: as mídias são servidas de
# `public/imgs` pelo próprio Next, exatamente como sempre foi.
#
# DEFINIDO = modo CDN: todo path `/imgs/...` vira URL absoluta nessa base.
# O host também é liberado automaticamente no CSP (`next.config.ts`), então
# não existe o caso "aponta pro CDN mas o navegador bloqueia".
#
# Regras: sem barra no final, sem query string (o Modal deriva o rótulo da
# imagem a partir do nome do arquivo).
NEXT_PUBLIC_MEDIA_BASE_URL=

# ─── URL canônica do site (robots.txt e sitemap.xml) ─────────────────────────
# Fallback no código: https://guittamonatega.com
NEXT_PUBLIC_SITE_URL=
