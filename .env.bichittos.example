# Credenciais exclusivas dos Bichittos.
# Nunca reutilize estas variaveis para Kammara ou Guitta Monatega Studio.
BICHITTOS_META_ACCESS_TOKEN=
BICHITTOS_FACEBOOK_PAGE_ACCESS_TOKEN=
BICHITTOS_META_GRAPH_API_VERSION=v24.0
BICHITTOS_INSTAGRAM_USER_ID=
BICHITTOS_FACEBOOK_PAGE_ID=
BICHITTOS_AWS_REGION=us-east-1
BICHITTOS_AWS_ROLE_ARN=
BICHITTOS_AUTOMATION_BUCKET=

# Barreiras do publicador seguro dos Bichittos (espelham as do Studio).
# Só o literal `true` habilita cada rota.
# Rota manual supervisionada: exige BICHITTOS_META_MANUAL_SECRET e autorização descartável no S3.
BICHITTOS_META_ROUTE_ENABLED=
BICHITTOS_META_MANUAL_SECRET=
# Cron agendado: exige CRON_SECRET (enviado pela Vercel) e `_schedule-control.json` ligado no S3.
BICHITTOS_META_CRON_ENABLED=
