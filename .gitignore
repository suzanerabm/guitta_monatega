# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o template, que documenta as variáveis e não tem segredo nenhum.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers / storybook / playwright
.superpowers/
storybook-static/
playwright-report/
test-results/
dist/
.astro/

# image asset backups (kept locally, never pushed)
_bkp/

# Mídia de conteúdo vive no S3 (ver AGENTS.md → "Mídia"). O que ainda está
# versionado em public/imgs é só o que o tooling local lê (pôster, stories) e
# continua rastreado; mídia nova não entra no git.
/public/imgs/**
!/public/imgs/**/
!/public/imgs/kammara/_capa/**

# ImageOptim artifacts (sidecar files it leaves behind)
*~imageoptim*
.*imageoptim*

# Server-only generated Kammara app content
/src/generated/kammara-app.json
