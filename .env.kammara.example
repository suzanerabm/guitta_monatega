# Credenciais exclusivas do Kammara.
# Nunca reutilize estas variaveis para Bichittos ou Guitta Monatega Studio.
KAMMARA_META_ACCESS_TOKEN=
KAMMARA_FACEBOOK_PAGE_ACCESS_TOKEN=
KAMMARA_META_GRAPH_API_VERSION=
KAMMARA_INSTAGRAM_USER_ID=
KAMMARA_FACEBOOK_PAGE_ID=
KAMMARA_AWS_REGION=
KAMMARA_AWS_ROLE_ARN=
KAMMARA_AUTOMATION_BUCKET=

# Barreiras do publicador seguro do Kammara (espelham as do Studio e dos Bichittos).
# Só o literal `true` habilita cada rota.
# Rota manual supervisionada: exige KAMMARA_META_MANUAL_SECRET e autorização descartável no S3.
KAMMARA_META_ROUTE_ENABLED=
KAMMARA_META_MANUAL_SECRET=
# Cron agendado: exige CRON_SECRET (enviado pela Vercel) e `_schedule-control.json` ligado no S3.
KAMMARA_META_CRON_ENABLED=
